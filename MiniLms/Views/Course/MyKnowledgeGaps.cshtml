@using System.Text.RegularExpressions
@model IEnumerable<MiniLms.Models.StudentKnowledgeGap>

@{
    ViewData["Title"] = "Ders ve Konu Bazlı Eksiklerim";
    var courseGroups = Model.GroupBy(g => g.CourseId).ToList();

    // 🎯 Benzer alaka ve anahtar kelimelere sahip konuları aynı kök grupta toplayan semantik kümeleyici
    string GetSemanticTopicCluster(string rawTopic)
    {
        if (string.IsNullOrWhiteSpace(rawTopic)) return "Genel Ders Konuları";
        
        string topic = rawTopic.Trim();

        // 1. Bilinen anahtar kalıplara göre semantik kümeleme
        if (Regex.IsMatch(topic, @"\bveri\s+ön\s*işlem", RegexOptions.IgnoreCase))
            return "Veri Ön İşleme Konuları";

        if (Regex.IsMatch(topic, @"\bveri\s+sentez", RegexOptions.IgnoreCase))
            return "Veri Sentezi Konuları";

        if (Regex.IsMatch(topic, @"\bveri\s+temizlem", RegexOptions.IgnoreCase))
            return "Veri Temizleme ve Düzenleme";

        if (Regex.IsMatch(topic, @"\bveri\s+madencil", RegexOptions.IgnoreCase))
            return "Veri Madenciliği Temelleri";

        if (Regex.IsMatch(topic, @"\bsayı\s+sistem", RegexOptions.IgnoreCase) || Regex.IsMatch(topic, @"\btümleyen\b", RegexOptions.IgnoreCase))
            return "Sayı Sistemleri ve Dönüşümler";

        if (Regex.IsMatch(topic, @"\bmantık\s+kapı", RegexOptions.IgnoreCase) || Regex.IsMatch(topic, @"\bkapılar\b", RegexOptions.IgnoreCase))
            return "Mantık Kapıları ve Devreler";

        if (Regex.IsMatch(topic, @"\bağ\s+katman", RegexOptions.IgnoreCase) || Regex.IsMatch(topic, @"\bprotokol", RegexOptions.IgnoreCase))
            return "Ağ Katmanı ve Protokolleri";

        // 2. Genel kural: Cümlenin ilk 2 kelimesine göre kök konu grubu oluştur
        var words = topic.Split(new[] { ' ', '-', ':', ',', '.', ';' }, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2)
        {
            return string.Join(" ", words.Take(2)) + " Konuları";
        }

        return topic;
    }

    int topicCounter = 0;
}

<div class="container py-4">
    <!-- HERO BAŞLIK KARTI -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-danger bg-opacity-20 text-danger-light fs-3">
                        <i class="bi bi-journal-x text-danger"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1 text-white">Ders ve Konu Grubu Bazlı Eksiklerim</h2>
                        <p class="text-white-50 mb-0 small">Yanlış yaptığınız sorular <strong>konularına göre gruplanmıştır</strong>. Konu bazlı veya ders bazlı karışık eksik testleri oluşturabilirsiniz.</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Derslerime Dön</a>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center py-5">
            <div class="card-body p-5">
                <div class="mb-3 text-success">
                    <i class="bi bi-check-circle-fill display-2"></i>
                </div>
                <h4 class="fw-bold text-slate-800">Tebrikler! Kayıtlı Eksik Konunuz Bulunmuyor</h4>
                <p class="text-muted mb-0">Quiz çözdükçe derslerinizdeki yanlış sorular ve benzer konular otomatik olarak burada gruplanacaktır.</p>
            </div>
        </div>
    }
    else
    {
        <!-- GENEL İSTATİSTİK BANTİ -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white d-flex flex-row align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary fs-4">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Eksik Bulunan Ders Sayısı</span>
                        <strong class="fs-4 text-dark"><span id="totalCourseCount">@courseGroups.Count</span> Ders</strong>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white d-flex flex-row align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-danger-subtle text-danger fs-4">
                        <i class="bi bi-x-octagon-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Toplam Hatalı Cevap Kaydı</span>
                        <strong class="fs-4 text-danger"><span id="totalErrorNum">@Model.Count()</span> Soru Kaydı</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- DERS BAZLI AKORDİYON LİSTESİ -->
        <div class="accordion d-flex flex-column gap-3" id="courseGapsAccordion">
            @foreach (var group in courseGroups)
            {
                var firstItem = group.First();
                var course = firstItem.Course;
                var courseTitle = course?.Title ?? "Bilinmeyen Ders";
                var courseCode = course?.CourseCode ?? "DERS";
                var totalWrongInCourse = group.Sum(g => g.WrongCount);
                var courseId = firstItem.CourseId;

                // 🎯 Semantik Konu Kümeleme
                var topicGroups = group.GroupBy(g => GetSemanticTopicCluster(g.TopicName))
                                       .OrderByDescending(tg => tg.Sum(x => x.WrongCount))
                                       .ToList();

                var courseTopTopics = topicGroups.Take(3).Select(g => new { Topic = g.Key, Count = g.Sum(x => x.WrongCount) });

                <div class="accordion-item shadow-sm border-0 rounded-4 overflow-hidden mb-1" id="course-card-@courseId">
                    <!-- AKORDİYON BAŞLIĞI (DERS ADI VE İSTATİSTİK) -->
                    <h2 class="accordion-header" id="heading-course-@courseId">
                        <button class="accordion-button collapsed py-3 px-4 fw-bold bg-white text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-course-@courseId" aria-expanded="false" aria-controls="collapse-course-@courseId">
                            <div class="d-flex justify-content-between align-items-center w-100 me-3 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo fw-bold px-3 py-2 fs-7" style="background-color: #e0e7ff; color: #4338ca; border-color: #c7d2fe!important;">
                                        <i class="bi bi-journal-text me-1"></i> @courseCode
                                    </span>
                                    <span class="fw-bold fs-5 text-slate-800">@courseTitle</span>
                                </div>
                                <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2.5 py-1.5 rounded-pill small">
                                        <i class="bi bi-layers-fill me-1"></i> @topicGroups.Count Semantik Konu Grubu
                                    </span>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-3 py-2 rounded-pill">
                                        <i class="bi bi-exclamation-circle me-1"></i> <span id="course-error-num-@courseId">@totalWrongInCourse</span> Hata Kaydı
                                    </span>
                                    <a asp-action="Details" asp-route-id="@firstItem.CourseId" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Derse Git
                                    </a>
                                </div>
                            </div>
                        </button>
                    </h2>

                    <!-- AKORDİYON İÇERİĞİ (TIKLANINCA AÇILIR) -->
                    <div id="collapse-course-@courseId" class="accordion-collapse collapse" aria-labelledby="heading-course-@courseId" data-bs-parent="#courseGapsAccordion">
                        <div class="accordion-body p-4" style="background-color: #f8fafc;">
                            <div class="row g-4">
                                <!-- SOL TARAF: BENZER KONULARINA VE SORULARA GÖRE İÇ İÇE TIKLANABİLİR LİSTE -->
                                <div class="col-lg-8">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <h6 class="fw-bold text-slate-700 mb-0">
                                            <i class="bi bi-diagram-3-fill text-primary me-1"></i> Konu Grupları:
                                        </h6>
                                        <span class="badge bg-secondary-subtle text-secondary small">@topicGroups.Count Konu Kümesi / <span id="course-total-questions-num-@courseId">@group.Count()</span> Soru</span>
                                    </div>

                                    <!-- SCROLL EDİLEBİLİR KONU & SORU LİSTESİ -->
                                    <div class="d-flex flex-column gap-3 pe-2" style="max-height: 580px; overflow-y: auto; scrollbar-width: thin;">
                                        @foreach (var topicGroup in topicGroups)
                                        {
                                            topicCounter++;
                                            var topicClusterName = topicGroup.Key;
                                            var wrongCountInTopic = topicGroup.Sum(x => x.WrongCount);

                                            <div class="card border border-primary-subtle shadow-sm rounded-3 bg-white overflow-hidden flex-shrink-0" id="topic-card-@topicCounter">
                                                <!-- SEMANTİK KONU GRUBU BAŞLIĞI (TIKLANABİLİR AKORDİYON & SİLME BUTONU) -->
                                                <div class="card-header py-2.5 px-3 bg-primary bg-opacity-10 border-bottom border-primary-subtle d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#topic-collapse-@topicCounter">
                                                        <i class="bi bi-folder-fill text-primary fs-6"></i>
                                                        <strong class="text-primary-emphasis fs-6">@topicClusterName</strong>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button type="button" class="btn btn-sm btn-primary text-white fw-bold border-0 py-1 px-2.5 rounded-pill shadow-sm"
                                                                title="Sadece bu konudaki eksiklerinizden özel test üretir"
                                                                onclick="startGapQuiz(event, @courseId, '@topicClusterName')">
                                                            <i class="bi bi-bullseye me-1"></i> Bu Konudan Quiz Çöz
                                                        </button>
                                                        <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 small">
                                                            <span id="topic-question-num-@topicCounter">@topicGroup.Count()</span> Soru / <span id="topic-error-num-@topicCounter">@wrongCountInTopic</span> Hata
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-outline-success bg-white text-success fw-bold border-success py-1 px-2.5 rounded-pill shadow-sm hover-scale"
                                                                title="Bu konuyu öğrendim, eksiklerimden kaldır"
                                                                onclick="confirmDeleteTopic(event, @courseId, '@topicClusterName', 'topic-card-@topicCounter', @topicCounter, @topicGroup.Count())">
                                                            <i class="bi bi-check-circle-fill me-1"></i> Öğrendim (Konuyu Sil)
                                                        </button>
                                                        <i class="bi bi-chevron-down text-primary small ms-1" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#topic-collapse-@topicCounter"></i>
                                                    </div>
                                                </div>

                                                <!-- KONU İÇİNDEKİ TIKLANABİLİR SORULAR LİSTESİ (VARSAYILAN KAPALI) -->
                                                <div id="topic-collapse-@topicCounter" class="collapse">
                                                    <div class="card-body p-3 d-flex flex-column gap-2">
                                                        @foreach (var gap in topicGroup)
                                                        {
                                                            <div class="border rounded-3 bg-white overflow-hidden shadow-sm" id="question-card-@gap.Id">
                                                                <!-- HER BİR SORU BAŞLIĞI (TIKLANINCA CEVAP AÇILIR) -->
                                                                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center"
                                                                     style="cursor: pointer;"
                                                                     data-bs-toggle="collapse"
                                                                     data-bs-target="#question-collapse-@gap.Id">
                                                                    <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                                                        <span class="badge bg-slate-200 text-slate-700 border small fw-semibold flex-shrink-0" style="background-color: #e2e8f0; color: #334155;">
                                                                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i> @(gap.Document?.FileName ?? "PDF")
                                                                        </span>
                                                                        <span class="fw-bold text-dark fs-6 text-truncate">
                                                                            <i class="bi bi-question-circle-fill text-danger me-1"></i> @gap.QuestionText
                                                                        </span>
                                                                    </div>
                                                                    <div class="d-flex align-items-center gap-2 flex-shrink-0" onclick="event.stopPropagation();">
                                                                        <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill px-2 py-1 small" style="font-size: 0.73rem;">
                                                                            <i class="bi bi-arrow-repeat me-1"></i> @gap.WrongCount Hata
                                                                        </span>
                                                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 py-0 px-2 rounded-circle" title="Bu soruyu sil" onclick="deleteQuestionItem(@gap.Id, 'question-card-@gap.Id', @courseId, @topicCounter)">
                                                                            <i class="bi bi-trash-fill"></i>
                                                                        </button>
                                                                        <i class="bi bi-chevron-down text-secondary small ms-1" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#question-collapse-@gap.Id"></i>
                                                                    </div>
                                                                </div>

                                                                <!-- TIKLANINCA AÇILAN DETAYLI SORU & CEVAP GÖVDESİ -->
                                                                <div id="question-collapse-@gap.Id" class="collapse">
                                                                    <div class="p-3 bg-white">
                                                                        <div class="mb-3 p-2 rounded bg-slate-100 border text-slate-800 fw-bold" style="background-color: #f1f5f9; font-size: 0.9rem;">
                                                                            <i class="bi bi-patch-question-fill text-danger me-1"></i> @gap.QuestionText
                                                                        </div>

                                                                        <!-- YANLIŞ VS DOĞRU CEVAP KUTULARI -->
                                                                        <div class="row g-2 mb-2">
                                                                            <div class="col-md-6">
                                                                                <div class="p-2.5 rounded-3 border border-danger-subtle" style="background-color: #fef2f2;">
                                                                                    <small class="d-block text-danger fw-bold mb-1" style="font-size: 0.72rem;">
                                                                                        <i class="bi bi-x-circle-fill me-1"></i> SİZİN SEÇİMİNİZ:
                                                                                    </small>
                                                                                    <span class="text-dark fw-semibold small">@gap.SelectedAnswer</span>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <div class="p-2.5 rounded-3 border border-success-subtle" style="background-color: #f0fdf4;">
                                                                                    <small class="d-block text-success fw-bold mb-1" style="font-size: 0.72rem;">
                                                                                        <i class="bi bi-check-circle-fill me-1"></i> DOĞRU CEVAP:
                                                                                    </small>
                                                                                    <span class="text-dark fw-semibold small">@gap.CorrectAnswer</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top" style="font-size: 0.78rem;">
                                                                            <span><i class="bi bi-tag-fill text-primary me-1"></i> Özel Konu: <strong class="text-dark">@gap.TopicName</strong></span>
                                                                            <span><i class="bi bi-clock-history me-1"></i> Kayıt: @gap.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- SAĞ TARAF: DERSE ÖZEL AKILLI İYİLEŞTİRME KARTI -->
                                <div class="col-lg-4">
                                    <div class="card border-0 shadow-sm rounded-3 bg-white h-100 position-sticky" style="top: 20px;">
                                        <div class="card-header border-0 py-3 text-white rounded-top-3" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
                                            <h6 class="mb-0 fw-bold small"><i class="bi bi-stars me-1"></i> @courseCode Akıllı İyileştirme Rehberi</h6>
                                        </div>
                                        <div class="card-body p-3">
                                            <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> En Çok Zorlanılan Konu Grupları:</h6>
                                            
                                            <div class="d-flex flex-column gap-2 mb-3">
                                                @foreach (var t in courseTopTopics)
                                                {
                                                    <div class="p-2 rounded-3 border border-danger-subtle d-flex justify-content-between align-items-center bg-white">
                                                        <span class="fw-semibold text-dark small"><i class="bi bi-folder-fill text-danger me-1"></i> @t.Topic</span>
                                                        <span class="badge bg-danger text-white rounded-pill">@t.Count Hata</span>
                                                    </div>
                                                }
                                            </div>

                                            <div class="p-3 rounded-3 border border-primary-subtle bg-primary-subtle text-primary small mb-3">
                                                <div class="fw-bold mb-1"><i class="bi bi-lightbulb-fill me-1 text-warning"></i> Tavsiye Olunan Adım:</div>
                                                <p class="mb-0 text-secondary" style="font-size: 0.82rem; line-height: 1.5;">
                                                    Bu derste en çok hata yaptığınız <strong>@courseTopTopics.FirstOrDefault()?.Topic</strong> kümesindeki konuları kapatmak için derse özel karışık quiz çözebilir veya sesli özeti dinleyebilirsiniz.
                                                </p>
                                            </div>

                                            <button type="button" class="btn btn-warning text-dark fw-bold w-100 rounded-pill py-2 shadow-sm"
                                                    title="Bu dersteki tüm eksik konulardan karışık test oluşturur"
                                                    onclick="startGapQuiz(event, @courseId, '')">
                                                <i class="bi bi-shuffle me-1"></i> @courseCode Karışık Quiz Çöz
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- 🎯 EKSİK KONULAR İÇİN ETKİLEŞİMLİ QUIZ MODALI -->
<div class="modal fade" id="gapQuizModal" tabindex="-1" aria-labelledby="gapQuizModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-primary text-white py-3">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="gapQuizModalLabel"><i class="bi bi-puzzle-fill me-2"></i> Eksik Konu Pekiştirme Quizi</h5>
                    <small class="text-white-50" id="gapQuizProgressText">Yapay zeka soruları hazırlıyor...</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="progress quiz-progress mb-3" role="progressbar" aria-label="Quiz ilerleme" style="height: 8px;">
                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" id="gapQuizProgressBar" style="width: 0%"></div>
                </div>

                <div id="gapQuizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="text-dark fw-bold mt-3 mb-1">Eksik Konularınız İnceleyerek Sorular Hazırlanıyor...</p>
                    <small class="text-muted">Yanlış yaptığınız kavramları tam olarak kavratacak sorular üretiliyor.</small>
                </div>

                <div id="gapQuizQuestionArea" class="d-none">
                    <div class="quiz-meta mb-3" id="gapQuizMeta"></div>
                    <h5 class="quiz-question fw-bold text-dark mb-3" id="gapQuizQuestionText"></h5>
                    <div id="gapQuizOptions" class="quiz-options d-flex flex-column gap-2 mb-3"></div>
                </div>

                <div id="gapQuizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score fs-2 fw-bold text-primary mb-1" id="gapQuizScoreText"></div>
                    <p class="text-muted mb-4" id="gapQuizScoreDetail"></p>
                    <div id="gapQuizReview" class="text-start"></div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2 justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="gapQuizNextBtn" disabled>Sonraki Soru <i class="bi bi-arrow-right ms-1"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- ONAY MODALI (MODAL CONFIRMATION DIALOG) -->
<div class="modal fade" id="deleteTopicModal" tabindex="-1" aria-labelledby="deleteTopicModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 bg-danger bg-opacity-10 text-danger py-3">
                <h5 class="modal-title fw-bold" id="deleteTopicModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Konuyu Öğrendim Olarak Sil
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2 text-dark fs-6">Emin misiniz? Şu anda <strong id="targetTopicName" class="text-danger"></strong> konusuna ait tüm eksik hata kayıtlarını siliyorsunuz.</p>
                <div class="p-3 rounded bg-light border border-info-subtle small text-muted">
                    <i class="bi bi-info-circle-fill text-info me-1"></i> Bu konudaki eksiklerinizi öğrendiğinizi onayladığınızda, ilgili sorular başarı listesinden kaldırılacaktır.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger btn-sm rounded-pill px-4" id="confirmDeleteTopicBtn">
                    <i class="bi bi-check-lg me-1"></i> Evet, Konuyu Sil
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        let currentCourseId = 0;
        let currentTopicName = '';
        let currentElementId = '';
        let currentTopicCounter = 0;
        let currentTopicQuestionCount = 0;

        let gapQuizState = {
            questions: [],
            currentIndex: 0,
            answers: [],
            selectedIndex: null,
            courseId: 0,
            documentId: 0,
            topicName: ''
        };

        function decrementNum(id, amount = 1) {
            let el = document.getElementById(id);
            if (el) {
                let val = parseInt(el.innerText) || 0;
                let newVal = Math.max(0, val - amount);
                el.innerText = newVal;
                return newVal;
            }
            return 0;
        }

        function confirmDeleteTopic(event, courseId, topicName, elementId, topicCounter, questionCount) {
            if (event) event.stopPropagation();
            
            currentCourseId = courseId;
            currentTopicName = topicName;
            currentElementId = elementId;
            currentTopicCounter = topicCounter;
            currentTopicQuestionCount = questionCount;

            document.getElementById('targetTopicName').innerText = `"${topicName}"`;
            
            let modalEl = document.getElementById('deleteTopicModal');
            let modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        document.getElementById('confirmDeleteTopicBtn').addEventListener('click', async function () {
            let modalEl = document.getElementById('deleteTopicModal');
            let modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                let response = await fetch('/Course/DeleteKnowledgeGapTopic', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ courseId: currentCourseId, topicName: currentTopicName })
                });

                let result = await response.json();
                if (result.success) {
                    let deletedAmount = result.deletedCount || currentTopicQuestionCount || 1;

                    decrementNum('totalErrorNum', deletedAmount);
                    decrementNum(`course-error-num-${currentCourseId}`, deletedAmount);
                    decrementNum(`course-total-questions-num-${currentCourseId}`, deletedAmount);

                    let cardEl = document.getElementById(currentElementId);
                    if (cardEl) {
                        cardEl.style.transition = 'all 0.3s ease';
                        cardEl.style.opacity = '0';
                        cardEl.style.transform = 'scale(0.95)';
                        setTimeout(() => { cardEl.remove(); }, 300);
                    }
                } else {
                    alert(result.message || 'Silme işlemi sırasında hata oluştu.');
                }
            } catch (err) {
                console.error(err);
                alert('Silme işlemi tamamlanamadı.');
            }
        });

        async function deleteQuestionItem(questionId, elementId, courseId, topicCounter) {
            if (!confirm('Bu soru kaydını eksiklerinizden silmek istediğinize emin misiniz?')) return;

            try {
                let response = await fetch('/Course/DeleteKnowledgeGapItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: questionId })
                });

                let result = await response.json();
                if (result.success) {
                    decrementNum('totalErrorNum', 1);
                    decrementNum(`course-error-num-${courseId}`, 1);
                    decrementNum(`course-total-questions-num-${courseId}`, 1);
                    decrementNum(`topic-question-num-${topicCounter}`, 1);
                    decrementNum(`topic-error-num-${topicCounter}`, 1);

                    let itemEl = document.getElementById(elementId);
                    if (itemEl) {
                        itemEl.style.transition = 'all 0.3s ease';
                        itemEl.style.opacity = '0';
                        setTimeout(() => { itemEl.remove(); }, 300);
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        // 🎯 EKSİK KONULARDAN QUIZ ÜRET & BAŞLAT HANDLER
        function startGapQuiz(event, courseId, topicName) {
            if (event) {
                if (event.preventDefault) event.preventDefault();
                if (event.stopPropagation) event.stopPropagation();
            }

            courseId = parseInt(courseId) || 0;
            topicName = topicName || "";

            gapQuizState = {
                questions: [],
                currentIndex: 0,
                answers: [],
                selectedIndex: null,
                courseId: courseId,
                documentId: 0,
                topicName: topicName
            };

            $("#gapQuizModalLabel").text("Eksik Konu Quizi Hazırlanıyor...");
            $("#gapQuizProgressText").text("Yapay zeka soruları hazırlıyor...");
            $("#gapQuizProgressBar").css("width", "0%");
            $("#gapQuizLoading").removeClass("d-none");
            $("#gapQuizQuestionArea").addClass("d-none");
            $("#gapQuizResultArea").addClass("d-none");
            $("#gapQuizNextBtn").prop("disabled", true).text("Sonraki Soru").removeClass("btn-success").addClass("btn-primary");

            let gapModalEl = document.getElementById('gapQuizModal');
            let gapModal = new bootstrap.Modal(gapModalEl);
            gapModal.show();

            $.ajax({
                url: '/Course/GenerateGapQuiz',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    courseId: courseId > 0 ? courseId : null,
                    topicName: topicName,
                    questionCount: 5,
                    difficulty: 'mixed'
                }),
                success: function (res) {
                    if (res.success && res.questions && res.questions.length > 0) {
                        gapQuizState.questions = res.questions;
                        gapQuizState.answers = new Array(res.questions.length).fill(null);
                        gapQuizState.currentIndex = 0;
                        gapQuizState.courseId = res.courseId || courseId;
                        gapQuizState.documentId = res.documentId || 0;

                        $("#gapQuizModalLabel").html(escapeHtml(res.title || "Eksik Konu Quizi"));
                        renderGapQuizQuestion();
                    } else {
                        $("#gapQuizLoading").addClass("d-none");
                        $("#gapQuizResultArea").removeClass("d-none");
                        $("#gapQuizScoreText").text("Quiz Hazırlanamadı");
                        $("#gapQuizScoreDetail").text(res.response || "Eksik konulara ait soru oluşturulamadı.");
                    }
                },
                error: function () {
                    $("#gapQuizLoading").addClass("d-none");
                    $("#gapQuizResultArea").removeClass("d-none");
                    $("#gapQuizScoreText").text("Hata Oluştu");
                    $("#gapQuizScoreDetail").text("Sunucu ile iletişim kurulurken bir sorun meydana geldi.");
                }
            });
        }

        function renderGapQuizQuestion() {
            let q = gapQuizState.questions[gapQuizState.currentIndex];
            gapQuizState.selectedIndex = gapQuizState.answers[gapQuizState.currentIndex];
            let progress = ((gapQuizState.currentIndex + 1) / gapQuizState.questions.length) * 100;

            $("#gapQuizLoading").addClass("d-none");
            $("#gapQuizResultArea").addClass("d-none");
            $("#gapQuizQuestionArea").removeClass("d-none");
            $("#gapQuizProgressText").text("Soru " + (gapQuizState.currentIndex + 1) + " / " + gapQuizState.questions.length);
            $("#gapQuizProgressBar").css("width", progress + "%");

            $("#gapQuizMeta").html(
                "<div class='d-flex align-items-center gap-2 flex-wrap'>" +
                "<span class='badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25'>" + escapeHtml(q.difficulty || "Orta") + "</span>" +
                "<span class='badge bg-info bg-opacity-10 text-info border border-info border-opacity-25'>" + escapeHtml(q.bloomLevel || "Kavrama") + "</span>" +
                "<span class='badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25'><i class='bi bi-tag-fill me-1'></i> " + escapeHtml(q.topic || "Eksik Konu") + "</span>" +
                "</div>"
            );
            $("#gapQuizQuestionText").text(q.question);
            $("#gapQuizNextBtn")
                .prop("disabled", gapQuizState.selectedIndex === null)
                .text(gapQuizState.currentIndex === gapQuizState.questions.length - 1 ? "Testi Bitir" : "Sonraki Soru")
                .removeClass("btn-success")
                .addClass("btn-primary");

            let optsHtml = "";
            q.options.forEach(function (opt, idx) {
                let selClass = gapQuizState.selectedIndex === idx ? " selected" : "";
                optsHtml += "<button type='button' class='quiz-option gap-quiz-option" + selClass + "' data-index='" + idx + "'><span>" + String.fromCharCode(65 + idx) + "</span><strong>" + escapeHtml(opt) + "</strong></button>";
            });
            $("#gapQuizOptions").html(optsHtml);
        }

        $(document).on("click", ".gap-quiz-option", function () {
            gapQuizState.selectedIndex = parseInt($(this).data("index"));
            $(".gap-quiz-option").removeClass("selected");
            $(this).addClass("selected");
            $("#gapQuizNextBtn").prop("disabled", false);
        });

        $("#gapQuizNextBtn").click(function () {
            if (gapQuizState.selectedIndex === null) return;
            gapQuizState.answers[gapQuizState.currentIndex] = gapQuizState.selectedIndex;

            if (gapQuizState.currentIndex >= gapQuizState.questions.length - 1) {
                renderGapQuizResult();
                return;
            }
            gapQuizState.currentIndex++;
            renderGapQuizQuestion();
        });

        function renderGapQuizResult() {
            let score = 0;
            let reviewHtml = "";

            gapQuizState.questions.forEach(function (question, index) {
                let userAnswer = gapQuizState.answers[index];
                let isCorrect = userAnswer === question.correctIndex;
                if (isCorrect) {
                    score++;
                } else {
                    let selectedOptText = (userAnswer !== null && question.options && question.options[userAnswer]) ? question.options[userAnswer] : "Yanıtlanmadı";
                    let correctOptText = (question.options && question.options[question.correctIndex]) ? question.options[question.correctIndex] : "";

                    $.ajax({
                        url: '/Course/RecordWrongAnswer',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            courseId: parseInt(gapQuizState.courseId) || 0,
                            courseDocumentId: parseInt(gapQuizState.documentId) || 0,
                            questionText: question.question,
                            selectedAnswer: selectedOptText,
                            correctAnswer: correctOptText,
                            topicName: question.topic || gapQuizState.topicName || "Eksik Konular"
                        })
                    });
                }

                reviewHtml += "<div class='quiz-review-item " + (isCorrect ? "correct" : "incorrect") + " position-relative shadow-sm mb-3 p-3 rounded-3 border " + (isCorrect ? "border-success bg-success bg-opacity-10" : "border-danger bg-danger bg-opacity-10") + "'>";
                reviewHtml += "<h6 class='fw-bold mb-2 text-dark'>" + (index + 1) + ". " + escapeHtml(question.question) + "</h6>";
                reviewHtml += "<div class='quiz-review-meta mb-2 small d-flex gap-2'>" +
                    "<span class='badge bg-secondary'>" + escapeHtml(question.topic || "Eksik Konu") + "</span>" +
                    "<span class='badge bg-info'>" + escapeHtml(question.bloomLevel || "Kavrama") + "</span>" +
                    "</div>";

                reviewHtml += "<div class='my-2 d-flex flex-column gap-1'>";
                question.options.forEach(function (optText, optIdx) {
                    let letter = String.fromCharCode(65 + optIdx);
                    if (optIdx === question.correctIndex) {
                        reviewHtml += "<div class='p-2 rounded bg-success text-white fw-bold d-flex justify-content-between'>" +
                            "<span>" + letter + ") " + escapeHtml(optText) + "</span> <span class='badge bg-white text-success'>Doğru Cevap</span></div>";
                    } else if (optIdx === userAnswer && !isCorrect) {
                        reviewHtml += "<div class='p-2 rounded bg-danger text-white fw-bold d-flex justify-content-between'>" +
                            "<span>" + letter + ") " + escapeHtml(optText) + "</span> <span class='badge bg-white text-danger'>Senin Seçimin</span></div>";
                    } else {
                        reviewHtml += "<div class='p-2 rounded bg-white text-secondary border'>" +
                            "<span>" + letter + ") " + escapeHtml(optText) + "</span></div>";
                    }
                });
                reviewHtml += "</div>";

                if (question.explanation) {
                    reviewHtml += "<div class='mt-2 p-2 rounded bg-white border small'><strong class='text-primary d-block'><i class='bi bi-lightbulb me-1'></i> AÇIKLAMA:</strong> " + escapeHtml(question.explanation) + "</div>";
                }
                reviewHtml += "</div>";
            });

            $("#gapQuizQuestionArea").addClass("d-none");
            $("#gapQuizResultArea").removeClass("d-none");
            $("#gapQuizScoreText").text("Skorunuz: " + score + " / " + gapQuizState.questions.length);
            $("#gapQuizScoreDetail").text("Eksik konu testini tamamladınız. Yanıtlarınızı aşağıdan kontrol edebilirsiniz.");
            $("#gapQuizReview").html(reviewHtml);
            $("#gapQuizNextBtn").prop("disabled", true).text("Test Tamamlandı").removeClass("btn-primary").addClass("btn-success");
        }
    </script>
}
