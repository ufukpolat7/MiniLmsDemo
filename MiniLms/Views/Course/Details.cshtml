@model MiniLms.Models.Course

@{
    ViewData["Title"] = Model.Title + " - Ders Detayları";
    var savedSummaries = ViewBag.SavedSummaries as List<MiniLms.Models.DocumentSummary> ?? new List<MiniLms.Models.DocumentSummary>();
    var enrolledStudents = ViewBag.EnrolledStudentSummaries as List<MiniLms.ViewModels.EnrolledStudentSummaryDto> ?? new List<MiniLms.ViewModels.EnrolledStudentSummaryDto>();
}

<style>
    .ql-editor h1, .ql-editor h2, .ql-editor h3,
    #aiResponseText h1, #aiResponseText h2, #aiResponseText h3,
    #selectedStudentSummariesContent h1, #selectedStudentSummariesContent h2, #selectedStudentSummariesContent h3 {
        color: #0066ff !important;
        font-weight: 700 !important;
    }
    .ql-toolbar.ql-snow {
        border-radius: 6px 6px 0 0;
        background: #f8fafc;
        border-color: #cbd5e1;
    }
    .ql-container.ql-snow {
        border-radius: 0 0 6px 6px;
        border-color: #cbd5e1;
    }
</style>

<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Başarılı!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Hata:</strong> @(TempData["ErrorMessage"] ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <section class="page-hero d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="hero-icon"><i class="bi bi-journal-richtext"></i></span>
            <div>
                <h1 class="page-title">@Model.Title</h1>
                <p class="page-subtitle">@Model.Description</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-primary border fs-6 px-3 py-2">@Model.CourseCode</span>
            @if (User.IsInRole("Teacher"))
            {
                <button type="button" class="btn btn-info text-white fw-bold shadow-sm" id="btnStudentSummariesModalTrigger">
                    <i class="bi bi-people-fill"></i> Öğrenci Özetleri
                </button>
            }
        </div>
    </section>

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3-week text-primary"></i> Haftalık Ders İçerikleri (1 - 14. Hafta)</h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary fs-7">1 Dönem = 14 Hafta</span>
                </div>
                <div class="card-body p-3" style="max-height: 680px; overflow-y: auto; padding-right: 6px; scrollbar-width: thin;">
                    <div class="accordion" id="lessonsAccordion">
                        @for (int w = 1; w <= 14; w++)
                        {
                            var currentWeek = w;
                            var weekDocs = Model.Documents != null ? Model.Documents.Where(d => d.WeekNumber == currentWeek).ToList() : new List<MiniLms.Models.CourseDocument>();
                            var weekLessons = Model.Lessons != null ? Model.Lessons.Where(l => l.WeekNumber == currentWeek).ToList() : new List<MiniLms.Models.Lesson>();
                            var hasContent = weekDocs.Any() || weekLessons.Any(l => l.Contents != null && l.Contents.Any());

                            <div class="accordion-item mb-2 border rounded overflow-hidden">
                                <h2 class="accordion-header" id="heading-week-@currentWeek">
                                    <button class="accordion-button @(currentWeek == 1 || hasContent ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-week-@currentWeek">
                                        <div class="d-flex align-items-center justify-content-between w-100 me-2">
                                            <span><i class="bi bi-calendar-event text-primary me-2"></i> @currentWeek. Hafta İçerikleri</span>
                                            @if (weekDocs.Any())
                                            {
                                                <span class="badge bg-primary rounded-pill small ms-2">@weekDocs.Count Doküman</span>
                                            }
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse-week-@currentWeek" class="accordion-collapse collapse @(currentWeek == 1 || hasContent ? "show" : "")" data-bs-parent="#lessonsAccordion">
                                    <div class="accordion-body bg-light p-3">
                                        @if (weekDocs.Any())
                                        {
                                            <div class="mb-3">
                                                <h6 class="fw-bold text-secondary mb-2" style="font-size: 0.85rem;">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> @currentWeek. Haftaya Eklenen Dokümanlar ve Konu Başlıkları:
                                                </h6>
                                                @foreach (var doc in weekDocs)
                                                {
                                                    var rawName = System.IO.Path.GetFileNameWithoutExtension(doc.FileName);
                                                    var docTopicLesson = weekLessons.FirstOrDefault(l => l.Title.Contains(rawName) || l.Title.StartsWith("Doküman Konuları"));
                                                    
                                                    <div class="card mb-3 border shadow-sm bg-white">
                                                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 border-bottom">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <i class="bi bi-file-earmark-text-fill text-primary fs-5"></i>
                                                                <div>
                                                                    <strong class="text-dark small d-block">@doc.FileName</strong>
                                                                    <small class="text-muted" style="font-size: 11px;">⏱️ Yüklenme: @doc.UploadedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                                                </div>
                                                            </div>
                                                            <a href="@doc.FilePath" target="_blank" class="btn btn-xs btn-outline-primary btn-sm"><i class="bi bi-box-arrow-up-right"></i> İncele / Aç</a>
                                                        </div>
                                                        <div class="card-body p-3">
                                                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-2" style="font-size: 0.85rem;">
                                                                <i class="bi bi-list-nested me-1"></i> Doküman İçerik ve Konu Başlıkları:
                                                            </h6>
                                                            @if (docTopicLesson != null && docTopicLesson.Contents != null && docTopicLesson.Contents.Any())
                                                            {
                                                                <div class="list-group list-group-flush">
                                                                    @foreach (var content in docTopicLesson.Contents.Where(c => c.Type == "DocumentTopic").OrderBy(c => c.Order))
                                                                    {
                                                                        <div class="list-group-item px-0 py-2 bg-transparent border-bottom-0">
                                                                            <div class="fw-bold text-dark small mb-1">
                                                                                <i class="bi bi-check-circle-fill text-primary me-1" style="font-size: 11px;"></i> @content.Title
                                                                            </div>
                                                                            @if (!string.IsNullOrWhiteSpace(content.Text))
                                                                            {
                                                                                <div class="small text-muted ms-3" style="font-size: 0.82rem; line-height: 1.4;">
                                                                                    @content.Text
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <p class="small text-muted mb-0"><i class="bi bi-cpu me-1"></i> Bu doküman için yapay zekâ anlamsal indekslemesi tamamlanmıştır.</p>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (weekLessons.Any(l => !l.Title.StartsWith("Doküman Konuları") && l.Title != "Yüklenen Dokümanlar"))
                                        {
                                            @foreach (var lesson in weekLessons.Where(l => !l.Title.StartsWith("Doküman Konuları") && l.Title != "Yüklenen Dokümanlar"))
                                            {
                                                <div class="card mb-2 border-0 bg-white shadow-sm p-3">
                                                    <h6 class="fw-bold text-dark mb-2">@lesson.Title</h6>
                                                    @if (lesson.Contents != null && lesson.Contents.Any())
                                                    {
                                                        foreach (var content in lesson.Contents.OrderBy(c => c.Order))
                                                        {
                                                            <div class="mb-2 ms-2">
                                                                <strong class="small text-dark d-block">@content.Title</strong>
                                                                <p class="small text-muted mb-0">@content.Text</p>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        }

                                        @if (!hasContent)
                                        {
                                            <div class="text-center py-3 text-muted">
                                                <small><i class="bi bi-info-circle me-1"></i> Bu haftaya ait henüz doküman yüklenmemiştir.</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card ai-panel mb-4 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-cpu text-primary"></i> Dersin Yapay Zeka Asistanı</h5>
                    <span class="badge bg-light text-primary border fw-bold">Gemini + Qdrant</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Yüklenen kurumsal dökümanlar ve haftalık içerikler üzerinde anlamsal arama yapılarak doğrudan ders kaynaklarına dayalı güvenli cevap üretilir.
                    </p>

                    <div id="aiResponseContainer" class="p-3 mb-3 border border-2 rounded bg-light d-none">
                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                            <span class="fw-bold text-primary small">
                                <i class="bi bi-chat-square-text"></i> <span id="aiResponseTitle">Asistanın Cevabı / Özet</span>
                                <span id="summaryBadge" class="badge bg-success ms-1 d-none"></span>
                            </span>
                            <div id="summaryActions" class="d-none d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-xs btn-outline-success btn-sm fw-bold" id="btnAudioSummary" title="Sesli Özet Dinle (Azure TTS)"><i class="bi bi-volume-up-fill"></i> Sesli Özet</button>
                                <button type="button" class="btn btn-xs btn-outline-warning btn-sm" id="btnEditSummary" title="Özeti Düzenle"><i class="bi bi-pencil-square"></i> Düzenle</button>
                                <button type="button" class="btn btn-xs btn-outline-info btn-sm" id="btnRefreshSummary" title="Yeniden AI Özeti Üret"><i class="bi bi-arrow-clockwise"></i> Yeniden Üret</button>
                                <button type="button" class="btn btn-xs btn-outline-danger btn-sm" id="btnDeleteSummary" title="Özeti Sil"><i class="bi bi-trash"></i> Sil</button>
                            </div>
                        </div>

                        <!-- 🔊 Azure Sesli Özet Oynatıcı Paneli -->
                        <div id="audioPlayerContainer" class="p-3 mb-2 bg-white rounded border d-none shadow-sm">
                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" id="btnRewind10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye Geri Al">
                                        <i class="bi bi-arrow-counterclockwise fs-6"></i>
                                    </button>
                                    <button type="button" id="btnPlayAudio" class="btn btn-sm btn-success rounded-circle shadow-sm" style="width:40px; height:40px; padding:0;" title="Oynat / Durdur">
                                        <i class="bi bi-play-fill fs-4"></i>
                                    </button>
                                    <button type="button" id="btnForward10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye İleri Al">
                                        <i class="bi bi-arrow-clockwise fs-6"></i>
                                    </button>

                                    <div class="ms-1">
                                        <span id="audioStatusText" class="small fw-bold text-dark d-block mb-0">Sesli Özet Oynatıcı</span>
                                        <span id="audioSubText" class="small text-muted" style="font-size: 0.75rem;">Azure TTS Seslendirmesi</span>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <span id="audioTimeCurrent" class="small fw-bold text-primary" style="font-size: 0.8rem;">00:00</span>
                                    <span class="small text-muted">/</span>
                                    <span id="audioTimeDuration" class="small text-muted" style="font-size: 0.8rem;">00:00</span>

                                    <label class="small text-muted mb-0 ms-2">Hız:</label>
                                    <select id="audioSpeedSelect" class="form-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.8rem;">
                                        <option value="1.0">1.0x</option>
                                        <option value="1.25">1.25x</option>
                                        <option value="1.5">1.5x</option>
                                        <option value="2.0">2.0x</option>
                                    </select>

                                    <button type="button" id="btnRefreshAudioSummary" class="btn btn-sm btn-outline-warning text-dark px-2" title="Yeniden Sesli Özet Üret">
                                        <i class="bi bi-arrow-repeat"></i> Yeniden Üret
                                    </button>

                                    <button type="button" id="btnDeleteAudioSummary" class="btn btn-sm btn-outline-danger px-2" title="Ses Kaydını Sil">
                                        <i class="bi bi-trash"></i> Sesi Sil
                                    </button>

                                    <a id="btnDownloadAudio" href="#" download class="btn btn-sm btn-outline-secondary d-none" title="MP3 Dosyasını İndir"><i class="bi bi-download"></i> İndir</a>
                                </div>
                            </div>

                            <div class="px-1">
                                <input type="range" id="audioSeekBar" class="form-range" min="0" max="100" value="0" step="0.1" style="cursor: pointer;" />
                            </div>

                            <audio id="summaryAudioPlayer" class="w-100 mt-2 d-none" controls></audio>
                        </div>

                        <div id="aiResponseText" class="lh-base" style="font-size: 0.95rem; max-height: 400px; overflow-y: auto; padding-right: 6px; scrollbar-width: thin;"></div>
                    </div>

                    <form id="askAiForm">
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Kaynak Filtresi</label>
                            <select class="form-select form-select-sm" name="documentId" id="documentIdSelect">
                                <option value="">Tüm Ders Kaynakları ve Dokümanlar</option>
                                @if (Model.Documents != null)
                                {
                                    foreach (var doc in Model.Documents)
                                    {
                                        <option value="@doc.Id">[@doc.WeekNumber. Hafta] @doc.FileName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="input-group">
                            <input type="text" name="question" id="aiQuestionInput" class="form-control" placeholder="Ders içeriklerine dair soru sorun..." required />
                            <button type="submit" id="btnAskAi" class="btn btn-primary fw-bold"><i class="bi bi-send"></i> Sor</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text text-primary"></i> Ek Ders Dokümanları</h5>
                    <span class="badge bg-light text-secondary border">@Model.Documents?.Count() Doküman</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var doc in Model.Documents)
                            {
                                var existingSummary = savedSummaries.FirstOrDefault(s => s.CourseDocumentId == doc.Id);
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div class="text-truncate me-2" style="max-width: 48%;">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-primary fw-bold" style="font-size: 10px;">@doc.WeekNumber. Hafta</span>
                                            <span class="fw-bold text-dark small d-block text-truncate">@doc.FileName</span>
                                            @if (existingSummary != null)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success" style="font-size: 10px;" title="Kayıtlı Özet Mevcut">Özet Kayıtlı</span>
                                            }
                                        </div>
                                        <small class="text-muted d-block" style="font-size: 11px;">⏱️ @doc.UploadedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <div class="d-flex gap-1 align-items-center">
                                        @if (User.IsInRole("Teacher"))
                                        {
                                            <form asp-action="UpdateDocumentWeek" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <select name="weekNumber" class="form-select form-select-sm d-inline-block py-0 px-1 border-primary" style="width: auto; font-size: 11px;" onchange="this.form.submit()" title="Dokümanın Haftasını Değiştir">
                                                    @for (int w = 1; w <= 14; w++)
                                                    {
                                                        if (doc.WeekNumber == w)
                                                        {
                                                            <option value="@w" selected="selected">Hafta @w</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@w">Hafta @w</option>
                                                        }
                                                    }
                                                </select>
                                            </form>
                                        }

                                        <a href="@doc.FilePath" target="_blank" class="btn btn-xs btn-outline-primary btn-sm" title="Aç"><i class="bi bi-box-arrow-up-right"></i></a>
                                        
                                        @if (existingSummary != null)
                                        {
                                            <button type="button" data-id="@doc.Id" class="btn btn-xs btn-success btn-sm btn-summary" title="Kayıtlı Özeti Aç"><i class="bi bi-book"></i> Özeti Oku</button>
                                        }
                                        else
                                        {
                                            <button type="button" data-id="@doc.Id" class="btn btn-xs btn-outline-success btn-sm btn-summary" title="Yapay Zeka ile Özet Çıkar"><i class="bi bi-magic"></i> Özetle</button>
                                        }

                                        <button type="button" data-id="@doc.Id" class="btn btn-xs btn-outline-success btn-sm btn-audio-summary-card" title="Sesli Özet Dinle"><i class="bi bi-volume-up-fill"></i> Sesli Dinle</button>
                                        <button type="button" data-id="@doc.Id" class="btn btn-xs btn-outline-primary btn-sm btn-quiz">Quiz</button>

                                        @if (User.IsInRole("Teacher"))
                                        {
                                            <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Bu dökümanı, veritabanı parçalarını ve yapay zeka vektör bellek kayıtlarını silmek istediğinize emin misiniz?');">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-xs btn-danger btn-sm" title="Sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Bu kursa henüz harici döküman yüklenmemiş.</p>
                    }
                </div>
            </div>

            @if (User.IsInRole("Student"))
            {
                <div class="card mb-4 border-primary shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-journal-bookmark-fill"></i> Kaydedilmiş Ders Özetlerim</h5>
                        <span class="badge bg-light text-primary fw-bold">@savedSummaries.Count Özet Kayıtlı</span>
                    </div>
                    <div class="card-body p-0">
                        @if (savedSummaries.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var summary in savedSummaries)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center p-3" id="summary-row-@summary.Id">
                                        <div class="text-truncate me-2" style="max-width: 55%;">
                                            <div class="d-flex align-items-center gap-1 mb-1">
                                                <span class="badge bg-primary fw-bold" style="font-size: 10px;">ID: #@summary.Id</span>
                                                <span class="fw-bold text-dark small text-truncate">@(summary.CourseDocument?.FileName ?? "Ders Dokümanı")</span>
                                            </div>
                                            <small class="text-muted d-block" style="font-size: 11px;">
                                                ⏱️ @summary.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                            </small>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-xs btn-primary btn-sm btn-read-summary-list" data-id="@summary.Id" data-docid="@summary.CourseDocumentId" title="Özeti Gör"><i class="bi bi-eye"></i> Oku</button>
                                            <button type="button" class="btn btn-xs btn-outline-warning btn-sm btn-edit-summary-list" data-id="@summary.Id" title="Özeti Düzenle"><i class="bi bi-pencil-square"></i></button>
                                            <button type="button" class="btn btn-xs btn-outline-danger btn-sm btn-delete-summary-list" data-id="@summary.Id" title="Özeti Sil"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-4 mb-0 small">Henüz bu ders için çıkarılmış kişisel özetiniz bulunmuyor. Doküman listesinden <strong>"Özetle"</strong> butonuna basarak ilk özetinizi oluşturabilirsiniz.</p>
                        }
                    </div>
                </div>
            }

            @if (User.IsInRole("Teacher"))
            {
                <div class="card mb-4 shadow-sm border-warning border-2">
                    <div class="card-header bg-white fw-bold py-3">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up text-primary"></i> Bilgi Havuzuna Doküman Ekle</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark"><i class="bi bi-calendar-range text-primary me-1"></i> Hangi Hafta İçin Yükleniyor? (1 Dönem = 14 Hafta)</label>
                                <select name="weekNumber" class="form-select form-select-sm fw-bold border-primary" required>
                                    @for (int w = 1; w <= 14; w++)
                                    {
                                        <option value="@w">@w. Hafta İçeriği Olarak Yükle</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-muted">Sistem otomatik olarak metin analizi yapıp indeksleme yapacaktır. (.pdf, .txt)</label>
                                <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.txt" required />
                            </div>
                            <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold shadow-sm"><i class="bi bi-cloud-upload"></i> Yükle ve @(Model.Title) Dersine İndeksle</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content quiz-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="quizModalLabel">Doküman Quiz</h5>
                    <small class="text-muted" id="quizProgressText">Hazırlanıyor...</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="quizSetup" class="quiz-setup mb-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small fw-bold text-secondary">Soru Sayısı</label>
                            <select class="form-select form-select-sm" id="quizQuestionCount">
                                <option value="3">3 soru</option>
                                <option value="5" selected>5 soru</option>
                                <option value="10">10 soru</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-bold text-secondary">Zorluk</label>
                            <select class="form-select form-select-sm" id="quizDifficulty">
                                <option value="mixed" selected>Karma</option>
                                <option value="easy">Kolay</option>
                                <option value="medium">Orta</option>
                                <option value="hard">Zor</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-primary btn-sm w-100" id="quizStartBtn">Başlat</button>
                        </div>
                    </div>
                </div>

                <div class="progress quiz-progress mb-3" role="progressbar" aria-label="Quiz ilerleme">
                    <div class="progress-bar" id="quizProgressBar" style="width: 0%"></div>
                </div>

                <div id="quizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Quiz hazırlanıyor...</p>
                </div>

                <div id="quizQuestionArea" class="d-none">
                    <div class="quiz-meta mb-3" id="quizMeta"></div>
                    <h5 class="quiz-question" id="quizQuestionText"></h5>
                    <div id="quizOptions" class="quiz-options"></div>
                    <div id="quizFeedback" class="quiz-feedback d-none"></div>
                </div>

                <div id="quizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score" id="quizScoreText"></div>
                    <p class="text-muted mb-3" id="quizScoreDetail"></p>
                    <div id="quizReview" class="text-start"></div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-danger btn-sm d-none" id="quizDeleteBtn" title="Kayıtlı Quizi Sil"><i class="bi bi-trash me-1"></i> Quizi Sil</button>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-primary" id="quizNextBtn" disabled>Sonraki</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🎯 ÖZET DÜZENLEME MODALI (WORD BENZERİ ZENGİN METİN EDİTÖRÜ) -->
<div class="modal fade" id="editSummaryModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title fw-bold" id="editSummaryModalTitle"><i class="bi bi-file-earmark-word"></i> Özet Düzenle (ID: #<span id="editSummaryIdText"></span>)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="editSummaryId" />
                <div class="mb-2">
                    <label class="form-label small fw-bold text-secondary d-flex align-items-center gap-1">
                        <i class="bi bi-fonts text-primary"></i> Microsoft Word Rehber Düzenleyici (Zengin Metin Editörü)
                    </label>
                    <div id="quillEditorContainer" style="background: #ffffff; border-radius: 4px;">
                        <div id="quillEditor" style="min-height: 280px; font-size: 15px; line-height: 1.6;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary btn-sm fw-bold" id="btnSaveEditedSummary"><i class="bi bi-check-circle"></i> Değişiklikleri Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- 🎯 ÖĞRETMEN PANELİ: ÖĞRENCİ ÖZETLERİ MODALI (ADIM 1: ÖĞRENCİ LİSTESİ, ADIM 2: ÖZETLER) -->
<div class="modal fade" id="studentSummariesListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-3">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill"></i> <span id="studentSummariesModalHeaderTitle">Derse Kayıtlı Öğrenciler ve Özetleri</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-0">
                <!-- ADIM 1: ÖĞRENCİ LİSTESİ GÖRÜNÜMÜ -->
                <div id="studentListViewSection">
                    @if (enrolledStudents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var student in enrolledStudents)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3 student-list-item" style="cursor: pointer;" data-studentid="@student.StudentId" data-studentname="@student.StudentName">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="fw-bold text-dark"><i class="bi bi-person-circle text-primary"></i> @student.StudentName</span>
                                            <span class="badge bg-secondary" style="font-size: 11px;">No: @student.StudentNumber</span>
                                            @if (student.Summaries.Any())
                                            {
                                                <span class="badge bg-success" style="font-size: 11px;">@student.Summaries.Count Özet Mevcut</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border" style="font-size: 11px;">Özet Yok</span>
                                            }
                                        </div>
                                        <small class="text-muted" style="font-size: 11px;">✉️ @student.Email</small>
                                    </div>
                                    <div>
                                        @if (student.Summaries.Any())
                                        {
                                            <button type="button" class="btn btn-xs btn-primary btn-sm btn-select-student" data-studentid="@student.StudentId" data-studentname="@student.StudentName">
                                                <i class="bi bi-file-earmark-pdf-fill"></i> Özetlerini Gör (@student.Summaries.Count) <i class="bi bi-chevron-right"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Özet Çıkarılmadı</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-5 mb-0">Bu derse henüz kayıtlı öğrenci bulunmamaktadır.</p>
                    }
                </div>

                <!-- ADIM 2: SEÇİLEN ÖĞRENCİNİN ÖZETLERİ GÖRÜNÜMÜ -->
                <div id="studentDetailSummaryViewSection" class="p-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" id="btnBackToStudentList">
                            <i class="bi bi-arrow-left"></i> Öğrenci Listesine Dön
                        </button>
                        <h6 class="fw-bold text-primary mb-0" id="selectedStudentTitle"></h6>
                    </div>
                    <div id="selectedStudentSummariesContent">
                        <span class="text-muted">Özetler yükleniyor...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        $(document).ready(function () {
        var quizState = {
        questions: [],
        currentIndex: 0,
        answers: [],
        selectedIndex: null,
        documentId: null
        };
        var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));

        // 🎯 1. RAG Yapay Zeka Soru Sorma AJAX Akışı
        $("#askAiForm").submit(function (e) {
        e.preventDefault();
        var btn = $("#btnAskAi");
        var container = $("#aiResponseContainer");
        var txt = $("#aiResponseText");

        btn.prop("disabled", true).text("Analiz Ediliyor...");
        container.removeClass("d-none");
        txt.html("<span class='text-muted italic'>Yapay zeka asistanı bağlamsal dökümanları tarıyor ve yanıt hazırlıyor, lütfen bekleyin...</span>");

        $.ajax({
        url: '@Url.Action("AskAi", "Course")',
        type: 'POST',
        data: $(this).serialize(),
        success: function (data) {
        if (data.success) {
        txt.html(formatAiResponseToHtml(data.response));
        } else {
        txt.html("<span class='text-danger fw-bold'>⚠️ Başarısız: " + data.response + "</span>");
        }
        },
        error: function () {
        txt.html("<span class='text-danger'>Ağ hatası! Yapay zeka servisine erişilemedi.</span>");
        },
        complete: function () {
        btn.prop("disabled", false).text("Soruyu Sor");
        }
        });
        });

        var activeSummaryState = {
            summaryId: null,
            documentId: null,
            rawText: ""
        };
        var editSummaryModal = new bootstrap.Modal(document.getElementById("editSummaryModal"));

        function loadDocumentSummary(docId, forceRefresh) {
            stopCurrentAudioPlayback();
            $("#audioPlayerContainer").addClass("d-none");

            var courseId = '@Model.Id';
            var container = $("#aiResponseContainer");
            var txt = $("#aiResponseText");

            container.removeClass("d-none");
            $('html, body').animate({ scrollTop: container.offset().top - 100 }, 400);

            if (forceRefresh) {
                txt.html("<span class='text-muted italic'>Yapay zeka dokümanı yeniden analiz edip güncel özet çıkarıyor...</span>");
            } else {
                txt.html("<span class='text-muted italic'>Doküman özeti veritabanından yükleniyor...</span>");
            }

            $.ajax({
                url: '@Url.Action("DocumentSummary", "Course")',
                type: 'GET',
                data: { courseId: courseId, documentId: docId, forceRefresh: forceRefresh },
                success: function (data) {
                    if (data.success) {
                        activeSummaryState.summaryId = data.summaryId;
                        activeSummaryState.documentId = data.documentId;
                        activeSummaryState.rawText = data.response;

                        txt.html(formatAiResponseToHtml(data.response));

                        if (data.summaryId) {
                            $("#summaryIdBadge").text(data.summaryId);
                            $("#summaryBadge").removeClass("d-none");
                            $("#summaryActions").removeClass("d-none");

                            if (data.isCached) {
                                $("#summaryBadge").text("Kayıtlı Özet Yüklendi (ID: #" + data.summaryId + ")");
                            } else {
                                $("#summaryBadge").text("Yeni Özet Kaydedildi (ID: #" + data.summaryId + ")");
                            }
                        }
                    } else {
                        txt.html("<span class='text-danger fw-bold'>⚠️ " + data.response + "</span>");
                        $("#summaryActions").addClass("d-none");
                        $("#summaryBadge").addClass("d-none");
                    }
                },
                error: function () {
                    txt.html("<span class='text-danger'>Özet yüklenirken teknik bir hata meydana geldi.</span>");
                }
            });
        }

        // 🎯 2. Tek Tıkla Doküman Özetleme (ID ile Geri Çekme & Önbellek)
        $(".btn-summary").click(function () {
            var docId = $(this).data("id");
            loadDocumentSummary(docId, false);
        });

        var quill = new Quill('#quillEditor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': ['#000000', '#0066ff', '#0056b3', '#dc3545', '#198754', '#ffc107', '#6c757d', '#6610f2', '#6f42c1', '#d63384', '#fd7e14', '#20c997', '#0dcaf0', '#ffffff'] }, 
                     { 'background': ['#ffffff', '#fff3cd', '#d1e7dd', '#f8d7da', '#cff4fc', '#e2e3e5', '#f8fafc', '#e0e7ff', '#fee2e2', '#dcfce7'] }],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        });

        function openEditModalWithSummary(summaryId, rawText) {
            $("#editSummaryId").val(summaryId);
            $("#editSummaryIdText").text(summaryId);

            if ($("#studentSummariesListModal").hasClass("show")) {
                studentSummariesListModal.hide();
            }

            editSummaryModal.show();

            var formattedHtml = formatAiResponseToHtml(rawText);

            setTimeout(function () {
                if (quill) {
                    quill.setText('');
                    quill.clipboard.dangerouslyPasteHTML(0, formattedHtml);
                }
            }, 200);
        }

        // 🎯 Yeniden AI Özeti Üret (Force Refresh)
        $("#btnRefreshSummary").click(function () {
            if (activeSummaryState.documentId) {
                if (confirm("Bu dokümanın özetini yapay zekaya yeniden ürettirmek istediğinizden emin misiniz?")) {
                    loadDocumentSummary(activeSummaryState.documentId, true);
                }
            }
        });

        // 🎯 🔊 Azure Sesli Özet Oluştur & Dinle (Audio Summary)
        var audioState = {
            isPlaying: false
        };

        var activeAudioRequestId = 0;

        function stopCurrentAudioPlayback() {
            var player = document.getElementById("summaryAudioPlayer");
            if (player) {
                try {
                    player.pause();
                    player.currentTime = 0;
                    player.removeAttribute("src");
                    player.load();
                } catch (e) { }
            }
            if ('speechSynthesis' in window) {
                try { window.speechSynthesis.cancel(); } catch (e) { }
            }
            audioState.isPlaying = false;
            $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>').prop("disabled", false);
            $("#audioTimeCurrent").text("00:00");
            $("#audioTimeDuration").text("00:00");
            $("#audioSeekBar").val(0);
        }

        function triggerAudioSummaryForDocument(docId, forceRefresh) {
            if (!docId) return;

            stopCurrentAudioPlayback();

            var thisRequestId = ++activeAudioRequestId;
            activeSummaryState.documentId = parseInt(docId);

            var container = $("#aiResponseContainer");
            container.removeClass("d-none");
            $("#summaryActions").removeClass("d-none");
            $('html, body').animate({ scrollTop: container.offset().top - 100 }, 400);

            $("#audioPlayerContainer").removeClass("d-none");
            $("#audioStatusText").text(forceRefresh ? "Yeni Sesli Özet Üretiliyor..." : "Sesli Özet Yükleniyor...");
            $("#audioSubText").text(forceRefresh ? "Edge Nöral Seslendirmesi Yapılıyor..." : "Önbellekten veya Ses Servisinden Çekiliyor");
            $("#btnPlayAudio").html('<div class="spinner-border spinner-border-sm text-light" role="status"></div>').prop("disabled", true);

            var courseId = '@Model.Id';

            $.ajax({
                url: '@Url.Action("GetAudioSummary", "Course")',
                type: 'GET',
                data: { courseId: courseId, documentId: docId, forceRefresh: forceRefresh === true },
                success: function (res) {
                    if (thisRequestId !== activeAudioRequestId) return;

                    $("#btnPlayAudio").prop("disabled", false);

                    if (res.success) {
                        if (res.summaryText) {
                            activeSummaryState.rawText = res.summaryText;
                            $("#aiResponseText").html(formatAiResponseToHtml(res.summaryText));
                        }

                        if (res.audioUrl) {
                            var player = document.getElementById("summaryAudioPlayer");
                            player.src = res.audioUrl;
                            $("#btnDownloadAudio").attr("href", res.audioUrl).removeClass("d-none");
                            $("#audioStatusText").text("Sesli Özet Hazır");
                            $("#audioSubText").text(res.isCached ? "💾 Önbellekten Yüklendi (Kayıtlı Ses)" : "✨ Microsoft Edge Nöral TTS (Yeni Ses)");
                            $("#btnPlayAudio").html('<i class="bi bi-pause-fill fs-4"></i>');
                            
                            var playPromise = player.play();
                            if (playPromise !== undefined) {
                                playPromise.then(function () {
                                    audioState.isPlaying = true;
                                }).catch(function (err) {
                                    console.log("Audio play exception:", err);
                                    $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>');
                                });
                            }

                            player.onended = function () {
                                audioState.isPlaying = false;
                                $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>');
                            };
                        } else {
                            $("#audioStatusText").text("Yerel Sesli Özet Oynatılıyor");
                            $("#audioSubText").text("Tarayıcı Türkçe Ses Motoru (Web Speech API)");
                            speakLocalText(res.summaryText || activeSummaryState.rawText);
                        }
                    } else {
                        stopCurrentAudioPlayback();
                        $("#audioPlayerContainer").addClass("d-none");
                        alert("⚠️ " + res.message);
                    }
                },
                error: function () {
                    if (thisRequestId !== activeAudioRequestId) return;
                    stopCurrentAudioPlayback();
                    $("#audioPlayerContainer").addClass("d-none");
                    alert("Sesli özet servisine bağlanırken sunucu hatası oluştu.");
                }
            });
        }

        // 🔄 Yeniden Sesli Özet Üret (Force Refresh)
        $(document).on("click", "#btnRefreshAudioSummary", function () {
            var docId = activeSummaryState.documentId;
            if (!docId) return;
            if (confirm("Bu dokümanın sesli özetini yeniden ürettirmek istediğinizden emin misiniz?")) {
                triggerAudioSummaryForDocument(docId, true);
            }
        });

        // 🗑️ Dokümana Ait Ses Kaydını Sil
        $(document).on("click", "#btnDeleteAudioSummary", function () {
            var docId = activeSummaryState.documentId;
            if (!docId) return;
            if (confirm("Bu dokümana ait ses kaydını veritabanından ve sunucudan silmek istediğinize emin misiniz?")) {
                var courseId = '@Model.Id';
                stopCurrentAudioPlayback();
                $("#audioPlayerContainer").addClass("d-none");

                $.ajax({
                    url: '@Url.Action("DeleteAudioSummary", "Course")',
                    type: 'POST',
                    data: { courseId: courseId, documentId: docId },
                    success: function (res) {
                        if (res.success) {
                            alert("✅ " + res.message);
                        } else {
                            alert("⚠️ " + res.message);
                        }
                    },
                    error: function () {
                        alert("Ses kaydı silinirken sunucu hatası oluştu.");
                    }
                });
            }
        });

        $(document).on("click", ".btn-audio-summary-card", function () {
            var docId = $(this).data("id");
            triggerAudioSummaryForDocument(docId);
        });

        $("#btnAudioSummary").click(function () {
            var docId = activeSummaryState.documentId || $("#documentIdSelect").val();
            if (!docId) {
                alert("Lütfen bir doküman seçin veya bir dokümanın yanındaki 'Sesli Dinle' butonuna tıklayın.");
                return;
            }
            triggerAudioSummaryForDocument(docId);
        });

        function formatAudioTime(seconds) {
            if (isNaN(seconds) || seconds < 0) return "00:00";
            var mins = Math.floor(seconds / 60);
            var secs = Math.floor(seconds % 60);
            return (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs);
        }

        var playerElement = document.getElementById("summaryAudioPlayer");
        if (playerElement) {
            playerElement.ontimeupdate = function () {
                if (playerElement.duration) {
                    var percent = (playerElement.currentTime / playerElement.duration) * 100;
                    $("#audioSeekBar").val(percent);
                    $("#audioTimeCurrent").text(formatAudioTime(playerElement.currentTime));
                }
            };

            playerElement.onloadedmetadata = function () {
                $("#audioTimeDuration").text(formatAudioTime(playerElement.duration));
            };
        }

        $("#audioSeekBar").on("input change", function () {
            if (playerElement && playerElement.duration) {
                var seekTo = ($(this).val() / 100) * playerElement.duration;
                playerElement.currentTime = seekTo;
            }
        });

        // ⏪ 10 Saniye Geri Al
        $("#btnRewind10").click(function () {
            if (playerElement && playerElement.src) {
                playerElement.currentTime = Math.max(0, playerElement.currentTime - 10);
            }
        });

        // ⏩ 10 Saniye İleri Al
        $("#btnForward10").click(function () {
            if (playerElement && playerElement.src) {
                playerElement.currentTime = Math.min(playerElement.duration || 0, playerElement.currentTime + 10);
            }
        });

        // 🎯 Oynat / Durdur Butonu
        $("#btnPlayAudio").click(function () {
            var player = document.getElementById("summaryAudioPlayer");
            if (player && player.src && player.src !== window.location.href) {
                if (player.paused) {
                    player.play();
                    $(this).html('<i class="bi bi-pause-fill fs-4"></i>');
                } else {
                    player.pause();
                    $(this).html('<i class="bi bi-play-fill fs-4"></i>');
                }
            } else if (window.speechSynthesis) {
                if (window.speechSynthesis.speaking) {
                    if (window.speechSynthesis.paused) {
                        window.speechSynthesis.resume();
                        $(this).html('<i class="bi bi-pause-fill fs-4"></i>');
                    } else {
                        window.speechSynthesis.pause();
                        $(this).html('<i class="bi bi-play-fill fs-4"></i>');
                    }
                }
            }
        });

        // 🎯 Oynatma Hızı Değiştirme
        $("#audioSpeedSelect").change(function () {
            var speed = parseFloat($(this).val());
            var player = document.getElementById("summaryAudioPlayer");
            if (player && player.src) {
                player.playbackRate = speed;
            }
        });

        // 🎯 Yerel Tarayıcı Türkçe Ses Motoru (SpeechSynthesis Fallback)
        function speakLocalText(rawText) {
            if (!('speechSynthesis' in window)) {
                alert("Tarayıcınız ses sentezleme özelliğini desteklemiyor.");
                return;
            }
            window.speechSynthesis.cancel();

            var cleanText = rawText.replace(/#+/g, '').replace(/\*\*/g, '').replace(/[-•]/g, '').trim();
            var utterance = new SpeechSynthesisUtterance(cleanText.substring(0, 1500));
            utterance.lang = 'tr-TR';
            utterance.rate = parseFloat($("#audioSpeedSelect").val() || "1.0");

            utterance.onstart = function () {
                $("#btnPlayAudio").html('<i class="bi bi-pause-fill fs-5"></i>');
            };
            utterance.onend = function () {
                $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-5"></i>');
            };

            window.speechSynthesis.speak(utterance);
        }

        // 🎯 Özeti Düzenle Modalını Aç
        $("#btnEditSummary").click(function () {
            if (!activeSummaryState.summaryId) return;
            openEditModalWithSummary(activeSummaryState.summaryId, activeSummaryState.rawText);
        });

        // 🎯 Düzenlenen Özeti Kaydet (Öğrenci veya Öğretmen)
        $("#btnSaveEditedSummary").click(function () {
            var summaryId = $("#editSummaryId").val();
