                $("#quizScoreDetail").text("Tüm sorular, doğru yanıtları, kaynak ipuçları ve detaylı açıklamaları ile aşağıda listelenmiştir.");

                var reviewHtml = "";
                questions.forEach(function (question, index) {
                    reviewHtml += "<div class='quiz-review-item correct position-relative shadow-sm mb-3 p-3 rounded-3 border border-success border-opacity-25 bg-white'>";
                    reviewHtml += "<div class='position-absolute top-0 end-0 m-3 d-flex align-items-center gap-1'>" + getDifficultyDotHtml(question.difficulty) + "</div>";
                    reviewHtml += "<h6 class='fw-bold mb-2 text-dark' style='font-size: 1.05rem;'>" + (index + 1) + ". " + escapeHtml(question.question) + "</h6>";
                    reviewHtml += "<div class='quiz-review-meta mb-3 d-flex flex-wrap gap-2'>" +
                        "<span class='badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25'><i class='bi bi-bar-chart me-1'></i> " + escapeHtml(question.difficulty || "Orta") + "</span>" +
                        "<span class='badge bg-info bg-opacity-10 text-info border border-info border-opacity-25'><i class='bi bi-mortarboard me-1'></i> " + escapeHtml(question.bloomLevel || "Anlama") + "</span>" +
                        "<span class='badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25'><i class='bi bi-tag me-1'></i> " + escapeHtml(question.topic || "Doküman içeriği") + "</span>" +
                        "</div>";

                    reviewHtml += "<div class='my-2 d-flex flex-column gap-2'>";
                    question.options.forEach(function (optText, optIdx) {
                        var letter = String.fromCharCode(65 + optIdx);
                        if (optIdx === question.correctIndex) {
                            reviewHtml += "<div class='quiz-review-option correct-option p-2 rounded bg-success bg-opacity-10 border border-success text-dark d-flex justify-content-between align-items-center'>" +
                                "<span><strong class='text-success me-2'>" + letter + ")</strong> " + escapeHtml(optText) + "</span> " +
                                "<span class='badge bg-success text-white px-2 py-1' style='font-size: 0.75rem;'><i class='bi bi-check-circle-fill me-1'></i> DOĞRU CEVAP</span>" +
                                "</div>";
                        } else {
                            reviewHtml += "<div class='quiz-review-option neutral-option p-2 rounded bg-light border text-secondary'>" +
                                "<span><strong class='me-2'>" + letter + ")</strong> " + escapeHtml(optText) + "</span>" +
                                "</div>";
                        }
                    });
                    reviewHtml += "</div>";

                    reviewHtml += "<div class='mt-3 p-3 rounded bg-light border border-secondary border-opacity-25'>" +
                        "<small class='d-block text-dark fw-bold mb-1'><i class='bi bi-lightbulb-fill text-warning me-1'></i> DOĞRU CEVAP AÇIKLAMASI:</small>" +
                        "<small class='text-secondary d-block mb-2' style='line-height:1.5;'>" + escapeHtml(question.explanation || "") + "</small>";

                    if (question.sourceHint) {
                        reviewHtml += "<small class='d-block text-muted border-top pt-2 mt-2'><i class='bi bi-search text-primary me-1'></i> Kaynak İpucu: " + escapeHtml(question.sourceHint) + "</small>";
                    }
                    reviewHtml += "</div></div>";
                });

                $("#quizReview").html(reviewHtml);
                $("#quizNextBtn").prop("disabled", true).text("Öğretmen İnceleme Modu").removeClass("btn-primary").addClass("btn-success");
