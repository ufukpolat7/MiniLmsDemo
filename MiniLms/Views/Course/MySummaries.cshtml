                            }
                        });
                    }
                }
            });

            function formatAudioTime(seconds) {
                if (isNaN(seconds) || seconds < 0) return "00:00";
                var mins = Math.floor(seconds / 60);
                var secs = Math.floor(seconds % 60);
                return (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs);
            }

            var player = document.getElementById("summaryAudioPlayer");
            player.ontimeupdate = function () {
                if (player.duration) {
                    var percent = (player.currentTime / player.duration) * 100;
                    $("#audioSeekBar").val(percent);
                    $("#audioTimeCurrent").text(formatAudioTime(player.currentTime));
                    $("#audioTimeDuration").text(formatAudioTime(player.duration));
                }
            };

            $("#audioSeekBar").on("input change", function () {
                if (player.duration) {
                    var newTime = (parseFloat($(this).val()) / 100) * player.duration;
                    player.currentTime = newTime;
                }
            });

            $("#btnPlayAudio").click(function () {
                if (!player.src) return;
                if (audioState.isPlaying) {
                    player.pause();
                    audioState.isPlaying = false;
                    $(this).html('<i class="bi bi-play-fill fs-4"></i>');
                } else {
                    player.play();
                    audioState.isPlaying = true;
                    $(this).html('<i class="bi bi-pause-fill fs-4"></i>');
                }
            });

            $("#btnRewind10").click(function () {
                if (player.currentTime) player.currentTime = Math.max(0, player.currentTime - 10);
            });
            $("#btnForward10").click(function () {
                if (player.duration && player.currentTime) player.currentTime = Math.min(player.duration, player.currentTime + 10);
            });
            $("#audioSpeedSelect").change(function () {
                player.playbackRate = parseFloat($(this).val());
            });

