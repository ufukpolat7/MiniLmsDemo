            // 🎯 KAYDEDİLMİŞ QUIZI ÇÖZ / İNCELE
            $(document).on("click", ".btn-solve-quiz", function () {
                var quizId = $(this).data("quizid");
                var courseId = $(this).data("courseid");
                var docId = $(this).data("docid");
                var isTeacherUser = @(isTeacherRole ? "true" : "false");

                quizState.documentId = docId;
                quizState.courseId = courseId;

                resetQuizModal();
                quizModal.show();

                $.ajax({
                    url: '@Url.Action("DocumentQuizSession", "Course")',
                    type: 'GET',
                    data: { courseId: courseId, documentId: docId, quizId: quizId },
                    success: function (data) {
                        if (data.success && data.questions && data.questions.length > 0) {
                            var cacheBadge = " <span class='badge bg-info text-white' style='font-size:0.75rem!important;'>💾 Kaydedilmiş Quiz (ID: #" + data.quizId + ")</span>";
                            $("#quizModalLabel").html(escapeHtml(data.title || "Doküman Quiz") + cacheBadge);
                            if (data.sourceFileName) {
                                $("#quizProgressText").html("<span class='text-primary fw-bold'><i class='bi bi-file-earmark-pdf-fill text-danger me-1'></i> Kaynak PDF: " + escapeHtml(data.sourceFileName) + "</span>");
                            }

                            if (data.teacherNote) {
                                $("#quizTeacherNoteText").text(data.teacherNote);
                                $("#quizTeacherNoteBanner").removeClass("d-none");
                                $("#quizTeacherNote").val(data.teacherNote);
                            } else {
                                $("#quizTeacherNoteBanner").addClass("d-none");
                                $("#quizTeacherNote").val("");
                            }

                            quizState.questions = data.questions;
                            quizState.answers = new Array(data.questions.length).fill(null);
                            quizState.currentIndex = 0;

                            // 🎯 ÖĞRETMEN TARAFINDA DİREKT CEVAP ANAHTARI GÖSTERİLİR, İŞARETLEME YAPILMAZ!
                            if (isTeacherUser) {
                                renderTeacherQuizAnswerKey(data.questions);
                            } else {
                                renderQuizQuestion();
                            }
                        } else {
                            showQuizError(data.response || "Quiz yüklenemedi.");
                        }
                    },
                    error: function () {
                        showQuizError("Quiz verisi alınırken sunucu hatası oluştu.");
                    }
                });
            });

