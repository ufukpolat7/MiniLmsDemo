@model IEnumerable<MiniLms.Models.DocumentSummary>

@{
    ViewData["Title"] = "Ders Özetlerim & Quizler";
    var savedQuizzes = ViewBag.SavedQuizzes as IEnumerable<MiniLms.Models.SavedQuiz>;
    var teacherSummaries = ViewBag.TeacherPublishedSummaries as IEnumerable<MiniLms.Models.DocumentSummary>;

    var teacherSummariesList = (ViewBag.TeacherPublishedSummaries as IEnumerable<MiniLms.Models.DocumentSummary>)?.ToList() ?? new List<MiniLms.Models.DocumentSummary>();
    var teacherQuizzesList = ViewBag.TeacherPublishedQuizzes as List<MiniLms.Models.SavedQuiz> ?? new List<MiniLms.Models.SavedQuiz>();

    var personalSummariesList = Model?.ToList() ?? new List<MiniLms.Models.DocumentSummary>();
    var personalQuizzesList = (ViewBag.SavedQuizzes as IEnumerable<MiniLms.Models.SavedQuiz>)?.ToList() ?? new List<MiniLms.Models.SavedQuiz>();

    var teacherCourseGroups = teacherSummariesList.Select(s => new { CourseId = s.CourseId, CourseTitle = s.Course?.Title ?? "Bilinmeyen Ders", CourseCode = s.Course?.CourseCode ?? "DERS" })
        .Union(teacherQuizzesList.Select(q => new { CourseId = q.CourseId, CourseTitle = q.Course?.Title ?? "Bilinmeyen Ders", CourseCode = q.Course?.CourseCode ?? "DERS" }))
        .Distinct()
        .ToList();

    var personalCourseGroups = personalSummariesList.Select(s => new { CourseId = s.CourseId, CourseTitle = s.Course?.Title ?? "Bilinmeyen Ders", CourseCode = s.Course?.CourseCode ?? "DERS" })
        .Union(personalQuizzesList.Select(q => new { CourseId = q.CourseId, CourseTitle = q.Course?.Title ?? "Bilinmeyen Ders", CourseCode = q.Course?.CourseCode ?? "DERS" }))
        .Distinct()
        .ToList();
}

<div class="container mt-4 mb-5">
    <!-- 🎯 BAŞLIK PANELİ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-bookmark-star-fill text-warning"></i> Ders Özetlerim & Quizlerim
            </h3>
            <p class="text-muted small mb-0">Öğretmenlerinizin yayınladığı resmi özetler ile kişisel AI özetleriniz ayrıştırılmıştır.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success fs-6 px-3 py-2 shadow-sm"><i class="bi bi-patch-check-fill me-1"></i> @(teacherSummaries?.Count() ?? 0) Öğretmen Özeti</span>
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm"><i class="bi bi-person-workspace me-1"></i> @(Model?.Count() ?? 0) Kişisel Özet</span>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2 shadow-sm"><i class="bi bi-puzzle-fill me-1"></i> @(savedQuizzes?.Count() ?? 0) Quiz Kayıtlı</span>
        </div>
    </div>

    <!-- 🔊 SESLİ ÖZET ÇALAR PANELİ (STICKY PLAYER) -->
    <div id="audioPlayerContainer" class="card shadow-sm border-primary mb-4 d-none bg-light">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="btnRewind10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye Geri Al">
                        <i class="bi bi-arrow-counterclockwise fs-6"></i>
                    </button>
                    <button type="button" id="btnPlayAudio" class="btn btn-sm btn-success rounded-circle shadow-sm" style="width:40px; height:40px; padding:0;" title="Oynat / Durdur">
                        <i class="bi bi-play-fill fs-4"></i>
                    </button>
                    <button type="button" id="btnForward10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye İleri Al">
                        <i class="bi bi-arrow-clockwise fs-6"></i>
                    </button>

                    <div class="ms-1">
                        <span id="audioStatusText" class="small fw-bold text-dark d-block mb-0">Sesli Özet Oynatıcı</span>
                        <span id="audioSubText" class="small text-muted" style="font-size: 0.75rem;">Microsoft Edge Nöral TTS (tr-TR-EmelNeural)</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span id="audioTimeCurrent" class="small fw-bold text-primary" style="font-size: 0.8rem;">00:00</span>
                    <span class="small text-muted">/</span>
                    <span id="audioTimeDuration" class="small text-muted" style="font-size: 0.8rem;">00:00</span>

                    <label class="small text-muted mb-0 ms-2">Hız:</label>
                    <select id="audioSpeedSelect" class="form-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.8rem;">
                        <option value="1.0">1.0x</option>
                        <option value="1.25">1.25x</option>
                        <option value="1.5">1.5x</option>
                        <option value="2.0">2.0x</option>
                    </select>

                    <button type="button" id="btnRefreshAudioSummary" class="btn btn-sm btn-outline-warning text-dark px-2" title="Yeniden Sesli Özet Üret">
                        <i class="bi bi-arrow-repeat"></i> Yeniden Üret
                    </button>

                    <button type="button" id="btnDeleteAudioSummary" class="btn btn-sm btn-outline-danger px-2" title="Ses Kaydını Sil">
                        <i class="bi bi-trash"></i> Sesi Sil
                    </button>

                    <a id="btnDownloadAudio" href="#" download class="btn btn-sm btn-outline-secondary d-none" title="MP3 Dosyasını İndir"><i class="bi bi-download"></i> İndir</a>
                </div>
            </div>

            <div class="px-1">
                <input type="range" id="audioSeekBar" class="form-range" min="0" max="100" value="0" step="0.1" style="cursor: pointer;" />
            </div>

            <audio id="summaryAudioPlayer" class="d-none"></audio>
        </div>
    </div>

    @{
        bool isTeacherRole = ViewBag.IsTeacher == true || User.IsInRole("Teacher");
    }
    <!-- 🎓 VE 📝 SEKMELİ KATEGORİ PANELİ (TABLAR) -->
    <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-4 border shadow-sm" id="summaryCategoryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold py-2.5 rounded-3" id="teacher-tab" data-bs-toggle="pill" data-bs-target="#teacherSummariesPane" type="button" role="tab">
                <i class="bi bi-patch-check-fill text-success me-1"></i> @(isTeacherRole ? "🎓 Öğrencilere Yayınladığım Onaylı Özetler" : "🎓 Öğretmenlerimin Yayınladığı Özetler") (@(teacherSummaries?.Count() ?? 0))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold py-2.5 rounded-3" id="personal-tab" data-bs-toggle="pill" data-bs-target="#personalSummariesPane" type="button" role="tab">
                <i class="bi bi-person-workspace text-primary me-1"></i> 📝 Benim Çıkardığım Kişisel Özetler (@(Model?.Count() ?? 0))
            </button>
        </li>
    </ul>

    <div class="tab-content" id="summaryCategoryTabContent">
        <!-- 🎯 TAB 1: ÖĞRETMENLERİN YAYINLADIĞI ÖZETLER VE QUİZLER -->
        <div class="tab-pane fade show active" id="teacherSummariesPane" role="tabpanel" aria-labelledby="teacher-tab">
            @if (teacherCourseGroups.Any())
            {
                <div class="accordion shadow-sm rounded border mb-4" id="teacherCourseAccordion">
                    @for (int i = 0; i < teacherCourseGroups.Count; i++)
                    {
                        var group = teacherCourseGroups[i];
                        string accordionId = $"collapse-teacher-course-{group.CourseId}";
                        string headingId = $"heading-teacher-course-{group.CourseId}";
                        bool isFirst = i == 0;

                        var courseTeacherSummaries = teacherSummariesList.Where(s => s.CourseId == group.CourseId).ToList();
                        var courseTeacherQuizzes = teacherQuizzesList.Where(q => q.CourseId == group.CourseId).ToList();

                        <div class="accordion-item border-0 mb-2 rounded shadow-xs overflow-hidden">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(isFirst ? "" : "collapsed") bg-success bg-opacity-10 text-dark fw-bold py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@accordionId">
                                    <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                        <div>
                                            <span class="badge bg-success me-2 px-2 py-1">@group.CourseCode</span>
                                            <span class="fs-6 text-dark fw-bold">@group.CourseTitle</span>
                                        </div>
                                        <span class="badge bg-white text-success border border-success px-3 py-1">
                                            <i class="bi bi-patch-check-fill me-1"></i> @courseTeacherSummaries.Count Eğitmen Özeti, @courseTeacherQuizzes.Count Eğitmen Quizi
                                        </span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@accordionId" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#teacherCourseAccordion">
                                <div class="accordion-body bg-white p-3">
                                    @if (courseTeacherSummaries.Any())
                                    {
                                        <div class="mb-3">
                                            <h6 class="fw-bold text-success mb-3"><i class="bi bi-file-earmark-text-fill text-success me-1"></i> 🎓 Eğitmen Onaylı Ders Özetleri</h6>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                @foreach (var summary in courseTeacherSummaries)
                                                {
                                                    var teacherUser = summary.PublishedByTeacher ?? summary.User;
                                                    string teacherName = teacherUser != null ? $"{teacherUser.FirstName} {teacherUser.LastName}".Trim() : "Ders Öğretmeni";

                                                    <div class="col" id="my-summary-card-@summary.Id">
                                                        <div class="card h-100 shadow-sm border border-success-subtle rounded-3" style="background-color: #f0fdf4;">
                                                            <div class="card-header bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="badge bg-success me-1"><i class="bi bi-patch-check-fill me-1"></i> Eğitmen Onaylı</span>
                                                                    @if (!string.IsNullOrEmpty(summary.AudioFilePath))
                                                                    {
                                                                        <span class="badge bg-primary" style="font-size: 10px;"><i class="bi bi-volume-up-fill"></i> Sesli Dinlenebilir</span>
                                                                    }
                                                                </div>
                                                                <small class="text-muted" style="font-size: 11px;">⏱️ @((summary.PublishedAt ?? summary.CreatedAt).ToString("dd.MM.yyyy HH:mm"))</small>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@summary.CourseDocument?.FileName">
                                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> @(summary.CourseDocument?.FileName ?? "Ders Dokümanı")
                                                                </h6>
                                                                <small class="text-success fw-semibold d-block mb-2"><i class="bi bi-person-fill me-1"></i> @teacherName tarafından yayınlandı</small>
                                                                <div class="bg-white p-2.5 rounded border border-success-subtle text-muted small" style="max-height: 85px; overflow: hidden; font-size: 0.85rem;">
                                                                    @(summary.SummaryText.Length > 160 ? summary.SummaryText.Substring(0, 160) + "..." : summary.SummaryText)
                                                                </div>
                                                            </div>
                                                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex align-items-center justify-content-between gap-1">
                                                                <button type="button" class="btn btn-xs btn-success btn-sm btn-audio-summary-card" data-courseid="@summary.CourseId" data-docid="@summary.CourseDocumentId" title="Sesli Özeti Dinle">
                                                                    <i class="bi bi-volume-up-fill me-1"></i> Sesli Dinle
                                                                </button>
                                                                <div class="d-flex gap-1">
                                                                    <button type="button" class="btn btn-xs btn-primary btn-sm btn-view-modal" data-id="@summary.Id" data-title="@summary.CourseDocument?.FileName" title="Özeti Gör">
                                                                        <i class="bi bi-book-half me-1"></i> Eğitmen Özetini Oku
                                                                    </button>
                                                                    @if (isTeacherRole)
                                                                    {
                                                                        <button type="button" class="btn btn-xs btn-warning btn-sm text-white btn-edit-modal" data-id="@summary.Id" title="Özeti Düzenle"><i class="bi bi-pencil-square"></i></button>
                                                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm btn-unpublish-summary-card" data-id="@summary.Id" title="Yayından Kaldır / Taslağa Çek"><i class="bi bi-eye-slash"></i> Yayından Kaldır</button>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (courseTeacherQuizzes.Any())
                                    {
                                        <div class="pt-3 border-top mt-3">
                                            <h6 class="fw-bold text-success mb-3"><i class="bi bi-puzzle-fill text-success me-1"></i> 🎓 Eğitmen Tarafından Gönderilen Onaylı Quizler</h6>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                @foreach (var quiz in courseTeacherQuizzes)
                                                {
                                                    <div class="col" id="my-quiz-card-@quiz.Id">
                                                        <div class="card h-100 shadow-sm border-success border-opacity-50 rounded-3">
                                                            <div class="card-header bg-success bg-opacity-10 border-0 py-2 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="badge bg-success me-1" style="font-size: 10px;">Eğitmen Quizi #@quiz.Id</span>
                                                                    <span class="badge bg-dark text-white fw-bold" style="font-size: 10px;">@quiz.Difficulty.ToUpper()</span>
                                                                </div>
                                                                <small class="text-muted" style="font-size: 11px;">⏱️ @(quiz.PublishedAt?.ToString("dd.MM.yyyy HH:mm") ?? quiz.CreatedAt.ToString("dd.MM.yyyy HH:mm"))</small>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@quiz.Title">
                                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> @quiz.Title
                                                                </h6>
                                                                @if (!string.IsNullOrWhiteSpace(quiz.TopicFocus))
                                                                {
                                                                    <div class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 small mb-2 text-wrap text-start">
                                                                        🎯 Konu Odağı: @quiz.TopicFocus
                                                                    </div>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(quiz.TeacherNote))
                                                                {
                                                                    <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info-emphasis small py-1 px-2 mb-2 rounded-2" style="font-size: 0.8rem;">
                                                                        <i class="bi bi-chat-left-quote-fill text-info me-1"></i> <strong>Öğretmen Notu:</strong> @quiz.TeacherNote
                                                                    </div>
                                                                }
                                                                <small class="text-muted d-block"><i class="bi bi-question-circle me-1"></i> Toplam @quiz.QuestionCount Soru Hazır</small>
                                                            </div>
                                                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                                                <div class="d-flex gap-1">
                                                                    <button type="button" class="btn btn-xs btn-success btn-sm btn-solve-quiz" data-quizid="@quiz.Id" data-courseid="@quiz.CourseId" data-docid="@quiz.CourseDocumentId">
                                                                        <i class="bi bi-eye-fill me-1"></i> @(isTeacherRole ? "Quizi İncele & Cevaplar" : $"Quizi Çöz (#Quiz-{quiz.Id})")
                                                                    </button>
                                                                    @if (isTeacherRole)
                                                                    {
                                                                        <button type="button" class="btn btn-xs btn-outline-secondary btn-sm btn-unpublish-quiz-card" data-quizid="@quiz.Id" title="Yayından Kaldır / Taslağa Çek">
                                                                            <i class="bi bi-eye-slash me-1"></i> Yayından Kaldır
                                                                        </button>
                                                                    }
                                                                </div>
                                                                @if (isTeacherRole)
                                                                {
                                                                    <button type="button" class="btn btn-xs btn-outline-danger btn-sm btn-delete-quiz" data-quizid="@quiz.Id" title="Quizi Sil">
                                                                        <i class="bi bi-trash"></i> Sil
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card shadow-sm p-5 text-center my-4 border-0 rounded-4">
                    <div class="mb-3 text-success">
                        <i class="bi bi-patch-check display-3"></i>
                    </div>
                    <h5 class="fw-bold text-slate-800">Henüz Öğretmeninizin Yayınladığı Özet Bulunmuyor</h5>
                    <p class="text-muted small">Ders öğretmeniniz bir doküman özetini düzenleyip yayınladığında resmi eğitmen özetleri bu bölümde sergilenecektir.</p>
                </div>
            }
        </div>

        <!-- 🎯 TAB 2: BENİM ÇIKARDIĞIM KİŞİSEL ÖZETLER VE QUİZLER -->
        <div class="tab-pane fade" id="personalSummariesPane" role="tabpanel" aria-labelledby="personal-tab">
            @if (personalCourseGroups.Any())
            {
                <div class="accordion shadow-sm rounded border mb-4" id="personalCourseAccordion">
                    @for (int i = 0; i < personalCourseGroups.Count; i++)
                    {
                        var group = personalCourseGroups[i];
                        string accordionId = $"collapse-personal-course-{group.CourseId}";
                        string headingId = $"heading-personal-course-{group.CourseId}";
                        bool isFirst = i == 0;

                        var coursePersonalSummaries = personalSummariesList.Where(s => s.CourseId == group.CourseId).ToList();
                        var coursePersonalQuizzes = personalQuizzesList.Where(q => q.CourseId == group.CourseId).ToList();

                        <div class="accordion-item border-0 mb-2 rounded shadow-xs overflow-hidden">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(isFirst ? "" : "collapsed") bg-light text-dark fw-bold py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@accordionId">
                                    <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                        <div>
                                            <span class="badge bg-primary me-2 px-2 py-1">@group.CourseCode</span>
                                            <span class="fs-6 text-dark fw-bold">@group.CourseTitle</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <span class="badge bg-white text-primary border border-primary px-3 py-1">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> @coursePersonalSummaries.Count Kişisel Özet
                                            </span>
                                            @if (coursePersonalQuizzes.Any())
                                            {
                                                <span class="badge bg-warning text-dark border border-warning px-3 py-1">
                                                    <i class="bi bi-puzzle-fill me-1"></i> @coursePersonalQuizzes.Count Quiz Kayıtlı
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="@accordionId" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#personalCourseAccordion">
                                <div class="accordion-body bg-white p-3">
                                    @if (coursePersonalSummaries.Any())
                                    {
                                        <div class="mb-3">
                                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-file-earmark-text text-primary me-1"></i> Çıkarılan Kişisel Ders Özetleri</h6>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                @foreach (var summary in coursePersonalSummaries)
                                                {
                                                    <div class="col" id="my-summary-card-@summary.Id">
                                                        <div class="card h-100 shadow-sm border-0 rounded-3">
                                                            <div class="card-header bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                                                                <span class="badge bg-secondary text-white" style="font-size: 10px;">ID: #@summary.Id</span>
                                                                <small class="text-muted" style="font-size: 11px;">⏱️ @summary.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@summary.CourseDocument?.FileName">
                                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> @(summary.CourseDocument?.FileName ?? "Ders Dokümanı")
                                                                </h6>
                                                                <div class="text-muted small text-truncate-2 mb-2" style="max-height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                                                    @(summary.SummaryText.Length > 160 ? summary.SummaryText.Substring(0, 160) + "..." : summary.SummaryText)
                                                                </div>
                                                            </div>
                                                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex align-items-center justify-content-between gap-1">
                                                                <button type="button" class="btn btn-xs btn-success btn-sm btn-audio-summary-card" data-courseid="@summary.CourseId" data-docid="@summary.CourseDocumentId" title="Sesli Özeti Dinle">
                                                                    <i class="bi bi-volume-up-fill me-1"></i> Sesli Dinle
                                                                </button>
                                                                <div class="d-flex gap-1">
                                                                    @if (isTeacherRole)
                                                                    {
                                                                        <button type="button" class="btn btn-xs btn-success btn-sm btn-publish-summary-card" data-id="@summary.Id" title="Bu Özeti Onaylayıp Öğrencilere Yayınla">
                                                                            <i class="bi bi-send-fill me-1"></i> Yayınla
                                                                        </button>
                                                                    }
                                                                    <button type="button" class="btn btn-xs btn-primary btn-sm btn-view-modal" data-id="@summary.Id" data-title="@summary.CourseDocument?.FileName" title="Özeti Gör"><i class="bi bi-eye"></i> Oku</button>
                                                                    <button type="button" class="btn btn-xs btn-warning btn-sm text-white btn-edit-modal" data-id="@summary.Id" title="Özeti Düzenle"><i class="bi bi-pencil-square"></i></button>
                                                                    <button type="button" class="btn btn-xs btn-danger btn-sm btn-delete-card" data-id="@summary.Id" title="Özeti Sil"><i class="bi bi-trash"></i></button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (coursePersonalQuizzes.Any())
                                    {
                                        <div class="pt-3 border-top mt-3">
                                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-puzzle-fill text-warning me-1"></i> Kaydedilmiş Kişisel / Taslak Quizler (#Quiz ID)</h6>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                @foreach (var quiz in coursePersonalQuizzes)
                                                {
                                                    <div class="col" id="my-quiz-card-@quiz.Id">
                                                        <div class="card h-100 shadow-sm border-warning border-opacity-50 rounded-3">
                                                            <div class="card-header bg-warning bg-opacity-10 border-0 py-2 d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <span class="badge bg-dark me-1" style="font-size: 10px;">Quiz ID: #@quiz.Id</span>
                                                                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 10px;">@quiz.Difficulty.ToUpper()</span>
                                                                </div>
                                                                <small class="text-muted" style="font-size: 11px;">⏱️ @quiz.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <h6 class="fw-bold text-dark mb-1 text-truncate" title="@quiz.SourceFileName">
                                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> @(quiz.SourceFileName)
                                                                </h6>
                                                                @if (!string.IsNullOrWhiteSpace(quiz.TopicFocus))
                                                                {
                                                                    <div class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 small mb-2 text-wrap text-start">
                                                                        🎯 Konu Odağı: @quiz.TopicFocus
                                                                    </div>
                                                                }
                                                                <small class="text-muted d-block mb-2"><i class="bi bi-question-circle me-1"></i> Toplam @quiz.QuestionCount Soru Hazır</small>
                                                            </div>
                                                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                                                <div class="d-flex gap-1">
                                                                    @if (isTeacherRole)
                                                                    {
                                                                        <button type="button" class="btn btn-xs btn-success btn-sm btn-publish-quiz-card" data-quizid="@quiz.Id" title="Bu Quizi Onaylayıp Derse Kayıtlı Tüm Öğrencilere Gönder">
                                                                            <i class="bi bi-send-fill me-1"></i> Öğrencilere Gönder
                                                                        </button>
                                                                        <button type="button" class="btn btn-xs btn-primary btn-sm btn-solve-quiz" data-quizid="@quiz.Id" data-courseid="@quiz.CourseId" data-docid="@quiz.CourseDocumentId">
                                                                            <i class="bi bi-eye-fill me-1"></i> Quizi İncele & Cevaplar
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-xs btn-primary btn-sm btn-solve-quiz" data-quizid="@quiz.Id" data-courseid="@quiz.CourseId" data-docid="@quiz.CourseDocumentId">
                                                                            <i class="bi bi-puzzle-fill me-1"></i> Quizi Çöz (#Quiz-@quiz.Id)
                                                                        </button>
                                                                    }
                                                                </div>
                                                                <button type="button" class="btn btn-xs btn-outline-danger btn-sm btn-delete-quiz" data-quizid="@quiz.Id" title="Quizi Sil">
                                                                    <i class="bi bi-trash"></i> Sil
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card shadow-sm p-5 text-center my-4 border-0 rounded-4">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-journal-bookmark display-3"></i>
                    </div>
                    <h5 class="fw-bold text-slate-800">Henüz Çıkardığınız Kişisel Bir AI Özet Bulunmuyor</h5>
                    <p class="text-muted small">Ders detay sayfasına giderek dokümanlarınız için <strong>"Özetle"</strong> butonuna tıkladığınızda kişisel özetleriniz buraya eklenecektir.</p>
                </div>
            }
        </div>
    </div>
</div>

