@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        function escapeHtml(text) {
            if (!text) return "";
            return text.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function formatAiResponseToHtml(text) {
            if (!text) return "";

            // Eğer önceden HTML olarak kaydedildiyse (Quill editörü)
            if (text.indexOf("<p>") !== -1 && text.indexOf("</p>") !== -1 && (text.indexOf("<strong>") !== -1 || text.indexOf("<h") !== -1 || text.indexOf("<ul>") !== -1)) {
                text = text.replace(/<p>\s*#+\s*(.*?)\s*<\/p>/gi, '<h3 style="color: #0066ff !important; font-weight: 700 !important; font-size: 1.22rem; margin-top: 1.4rem; margin-bottom: 0.6rem;">$1</h3>');
                text = text.replace(/<strong>(.*?)<\/strong>/gi, '<strong style="color: #000000 !important; font-weight: 700 !important;">$1<\/strong>');
                return text;
            }

            // 1. Temizlik ve Satır Sonu Düzenlemeleri
            text = text.replace(/\r\n/g, '\n');
            text = text.replace(/Ali\s+Gülbağ(\s+Mantık\s+Devreleri)?/gi, '');
            text = text.replace(/Zafer\s+Cömert/gi, '');
            text = text.replace(/BTK\s+Akademi/gi, '');

            // Bitişik kalmış madde işaretlerini (* Nereye..., - Temel..., 1. Adım...) yeni satıra ayır
            text = text.replace(/([.!?])\s*([*\-•])\s*(\*\*)/g, '$1\n\n$2 $3');
            text = text.replace(/([.!?])\s*(\d+\.\s+Adım)/gi, '$1\n\n### $2');

            var rawBlocks = text.split(/\n\n+/);
            var htmlBuilder = [];

            rawBlocks.forEach(function (block) {
                var trimmed = block.trim();
                if (!trimmed) return;

                var isExplicitHeader = /^#+\s*/.test(trimmed);
                var isShortTitle = /^(📍|SINAV İÇİN|DERS REHBERİ|Adım Adım Çalışma|Çalışma Yol Haritası)/i.test(trimmed) && trimmed.length < 75 && !/[.!?]$/.test(trimmed);
                var isNumberedHeading = /^(?:\d+|\d+\.\d+|[A-Z])\.\s+[A-ZÇĞİÖŞÜ0-9]/i.test(trimmed) && trimmed.length < 65 && !/[.!?]$/.test(trimmed.replace(/^#+\s*/, '').trim());

                if (isExplicitHeader || isShortTitle || isNumberedHeading) {
                    var cleanHeader = trimmed.replace(/^#+\s*/, '').replace(/\*\*/g, '').trim();
                    var isMainTitle = cleanHeader.toUpperCase().indexOf("DERS REHBERİ") !== -1;

                    if (isMainTitle) {
                        htmlBuilder.push('<h2 style="color: #0066ff !important; font-weight: 800 !important; font-size: 1.35rem; margin-top: 1.2rem; margin-bottom: 0.8rem; text-transform: uppercase; line-height: 1.3;">' + escapeHtml(cleanHeader) + '</h2>');
                    } else {
                        htmlBuilder.push('<h3 style="color: #0066ff !important; font-weight: 700 !important; font-size: 1.2rem; margin-top: 1.3rem; margin-bottom: 0.6rem; display: block; line-height: 1.35;">' + escapeHtml(cleanHeader) + '</h3>');
                    }
                }
                else {
                    var subLines = trimmed.split('\n');
                    subLines.forEach(function(subLine) {
                        var lineTrim = subLine.trim();
                        if (!lineTrim) return;

                        var formatted = escapeHtml(lineTrim);
                        formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong style="color: #000000 !important; font-weight: 700 !important;">$1</strong>');
                        formatted = formatted.replace(/\*([^*]+)\*/g, '<em style="color: #334155; font-style: italic;">$1</em>');

                        if (/^[*\-•]\s*/.test(lineTrim)) {
                            formatted = formatted.replace(/^[*\-•]\s*/, '');
                            htmlBuilder.push('<p style="font-weight: 400 !important; color: #1e293b; font-size: 1.02rem; line-height: 1.65; margin-bottom: 0.5rem; margin-left: 0.8rem;">• ' + formatted + '</p>');
                        } else {
                            htmlBuilder.push('<p style="font-weight: 400 !important; color: #1e293b; font-size: 1.02rem; line-height: 1.65; margin-bottom: 0.85rem;">' + formatted + '</p>');
                        }
                    });
                }
            });

            return htmlBuilder.join('');
        }

        $(document).ready(function () {
            var viewModal = new bootstrap.Modal(document.getElementById("viewSummaryModal"));
            var editModal = new bootstrap.Modal(document.getElementById("editSummaryModal"));
            var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));

            var quillMySummaries = new Quill('#quillEditorMySummaries', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': ['#000000', '#0066ff', '#0056b3', '#dc3545', '#198754', '#ffc107', '#6c757d', '#6610f2', '#6f42c1', '#d63384', '#fd7e14', '#20c997', '#0dcaf0', '#ffffff'] }, 
                         { 'background': ['#ffffff', '#fff3cd', '#d1e7dd', '#f8d7da', '#cff4fc', '#e2e3e5', '#f8fafc', '#e0e7ff', '#fee2e2', '#dcfce7'] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['clean']
                    ]
                }
            });

            // 🎯 QUIZ STATE
            var quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: null, courseId: null };

            function escapeHtml(text) {
                if (!text) return "";
                return text.toString()
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getDifficultyDotHtml(difficulty) {
                var diff = (difficulty || "").toString().toLowerCase();
                var dotClass = "easy";
                var titleText = "Kolay Seviye (Hatırlama ve Kavrama)";

                if (diff.indexOf("zor") !== -1 || diff.indexOf("hard") !== -1) {
                    dotClass = "hard";
                    titleText = "Zor Seviye (Değerlendirme ve Sentez)";
                } else if (diff.indexOf("orta") !== -1 || diff.indexOf("medium") !== -1) {
                    dotClass = "medium";
                    titleText = "Orta Seviye (Uygulama ve Analiz)";
                } else if (diff.indexOf("kolay") !== -1 || diff.indexOf("easy") !== -1) {
                    dotClass = "easy";
                    titleText = "Kolay Seviye (Hatırlama ve Kavrama)";
                }

                return '<span class="quiz-difficulty-dot ' + dotClass + '" title="' + titleText + '"></span>';
            }

            function resetQuizModal() {
                quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: quizState.documentId, courseId: quizState.courseId };
                $("#quizModalLabel").text("Doküman Quiz");
                $("#quizProgressText").text("Yükleniyor...");
                $("#quizProgressBar").css("width", "0%");
                $("#quizSetup").addClass("d-none");
                $("#quizLoading").removeClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizFeedback").addClass("d-none").empty();
                $("#quizOptions").empty();
                $("#quizNextBtn").prop("disabled", true).text("Sonraki").removeClass("btn-success").addClass("btn-primary");
            }

            function renderQuizQuestion() {
                var question = quizState.questions[quizState.currentIndex];
                quizState.selectedIndex = quizState.answers[quizState.currentIndex];
                var progress = ((quizState.currentIndex + 1) / quizState.questions.length) * 100;

                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizQuestionArea").removeClass("d-none");
                $("#quizProgressBar").css("width", progress + "%");

                var dotHtml = getDifficultyDotHtml(question.difficulty);

                $("#quizMeta").html(
                    "<div class='d-flex justify-content-between align-items-center w-100'>" +
                    "<div class='d-flex align-items-center gap-1 flex-wrap'>" +
                    "<span class='quiz-pill'>" + escapeHtml(question.difficulty || "Orta") + "</span>" +
                    "<span class='quiz-pill'>" + escapeHtml(question.bloomLevel || "Anlama") + "</span>" +
                    "<span class='quiz-pill muted'>" + escapeHtml(question.topic || "Doküman içeriği") + "</span>" +
                    "</div>" +
                    "<div class='d-flex align-items-center gap-2 me-1' title='Sorunun Zorluk Seviyesi (Bloom Taksonomisi)'>" +
                    "<small class='text-muted fw-bold' style='font-size: 0.72rem;'>ZORLUK:</small>" +
                    dotHtml +
                    "</div>" +
                    "</div>"
                );
                $("#quizQuestionText").text(question.question);
                $("#quizFeedback").addClass("d-none").empty();
                $("#quizNextBtn")
                    .prop("disabled", quizState.selectedIndex === null)
                    .text(quizState.currentIndex === quizState.questions.length - 1 ? "Bitir" : "Sonraki")
                    .removeClass("btn-success")
                    .addClass("btn-primary");

                var optionsHtml = "";
                question.options.forEach(function (option, index) {
                    var selectedClass = quizState.selectedIndex === index ? " selected" : "";
                    optionsHtml += "<button type='button' class='quiz-option" + selectedClass + "' data-index='" + index + "'><span>" + String.fromCharCode(65 + index) + "</span><strong>" + escapeHtml(option) + "</strong></button>";
                });
                $("#quizOptions").html(optionsHtml);
            }

            $(document).on("click", ".quiz-option", function () {
                quizState.selectedIndex = parseInt($(this).data("index"));
                $(".quiz-option").removeClass("selected");
                $(this).addClass("selected");
                $("#quizNextBtn").prop("disabled", false);
            });

            $("#quizNextBtn").click(function () {
                if (quizState.selectedIndex === null) return;
                quizState.answers[quizState.currentIndex] = quizState.selectedIndex;

                if (quizState.currentIndex >= quizState.questions.length - 1) {
                    renderQuizResult();
                    return;
                }
                quizState.currentIndex++;
                renderQuizQuestion();
            });

            function renderQuizResult() {
                var score = 0;
                var reviewHtml = "";
                var isTeacherUser = @(isTeacherRole ? "true" : "false");

                quizState.questions.forEach(function (question, index) {
                    var userAnswer = quizState.answers[index];
                    var isCorrect = userAnswer === question.correctIndex;
                    if (isCorrect) {
                        score++;
                    } else if (!isTeacherUser) {
                        var selectedOptText = (userAnswer !== null && question.options && question.options[userAnswer]) ? question.options[userAnswer] : "Yanıtlanmadı";
                        var correctOptText = (question.options && question.options[question.correctIndex]) ? question.options[question.correctIndex] : "";
                        
                        $.ajax({
                            url: '@Url.Action("RecordWrongAnswer", "Course")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                courseId: parseInt(quizState.courseId || 0),
                                courseDocumentId: parseInt(quizState.documentId || 0),
                                questionText: question.question,
                                selectedAnswer: selectedOptText,
                                correctAnswer: correctOptText,
                                topicName: question.topic || "Genel Konu"
                            })
                        });
                    }

                    reviewHtml += "<div class='quiz-review-item " + (isCorrect ? "correct" : "incorrect") + " position-relative shadow-sm'>";
                    reviewHtml += "<div class='position-absolute top-0 end-0 m-3 d-flex align-items-center gap-1'>" + getDifficultyDotHtml(question.difficulty) + "</div>";
                    reviewHtml += "<h6 class='fw-bold mb-2'>" + (index + 1) + ". " + escapeHtml(question.question) + "</h6>";
                    reviewHtml += "<div class='quiz-review-meta mb-2'><span>" + escapeHtml(question.difficulty || "Orta") + "</span><span>" + escapeHtml(question.bloomLevel || "Anlama") + "</span><span>" + escapeHtml(question.topic || "Doküman içeriği") + "</span></div>";

                    reviewHtml += "<div class='my-2'>";
                    question.options.forEach(function (optText, optIdx) {
                        var letter = String.fromCharCode(65 + optIdx);
                        if (optIdx === question.correctIndex) {
                            reviewHtml += "<div class='quiz-review-option correct-option'><span class='d-flex align-items-center gap-2'><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span> <span class='badge bg-success text-white px-2 py-1' style='font-size: 0.75rem;'><i class='bi bi-check-circle-fill me-1'></i> Doğru Cevap</span></div>";
                        } else if (optIdx === userAnswer && !isCorrect) {
                            reviewHtml += "<div class='quiz-review-option wrong-option'><span class='d-flex align-items-center gap-2'><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span> <span class='badge bg-danger text-white px-2 py-1' style='font-size: 0.75rem;'><i class='bi bi-x-circle-fill me-1'></i> Senin Yanlış Seçimin</span></div>";
                        } else {
                            reviewHtml += "<div class='quiz-review-option neutral-option'><span><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span></div>";
