                            <label class="form-label small fw-bold text-primary mb-1">
                                <i class="bi bi-chat-left-quote-fill me-1"></i> Öğretmen Notu / Öğrencilere İletilecek Mesaj <span class="fw-normal text-muted">(Opsiyonel)</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" id="quizTeacherNote" placeholder="Soruları inceledikten sonra öğrencilerinize iletmek istediğiniz notu buraya yazabilirsiniz..." />
                            <small class="text-muted mt-1 d-block" style="font-size: 11px;">
