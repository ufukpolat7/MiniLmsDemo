@model IEnumerable<MiniLms.Models.DocumentSummary>

@{
    ViewData["Title"] = "Özel Ders Özetlerim & Quizler";
    var savedQuizzes = ViewBag.SavedQuizzes as IEnumerable<MiniLms.Models.SavedQuiz>;

    var groupedSummaries = Model != null && Model.Any()
        ? Model.GroupBy(s => new {
            CourseId = s.CourseId,
            CourseTitle = s.Course?.Title ?? "Bilinmeyen Ders",
            CourseCode = s.Course?.CourseCode ?? "DERS"
          }).ToList()
        : null;
}

<div class="container mt-4 mb-5">
    <!-- 🎯 BAŞLIK PANERLİ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-bookmark-star-fill text-warning"></i> Özel Ders Özetlerim & Quizlerim
            </h3>
            <p class="text-muted small mb-0">Derslerinize göre kümelenmiş yapay zeka özetleriniz, sesli notlarınız ve kaydedilmiş quizleriniz.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">Toplam @(Model?.Count() ?? 0) Özet</span>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2 shadow-sm">Toplam @(savedQuizzes?.Count() ?? 0) Quiz Kayıtlı</span>
        </div>
    </div>

    <!-- 🔊 SESLİ ÖZET ÇALAR PANELİ (STICKY PLAYER) -->
    <div id="audioPlayerContainer" class="card shadow-sm border-primary mb-4 d-none bg-light">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <!-- ⏪ 10 sn Geri -->
                    <button type="button" id="btnRewind10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye Geri Al">
                        <i class="bi bi-arrow-counterclockwise fs-6"></i>
                    </button>

                    <!-- ▶️/⏸️ Oynat / Durdur -->
                    <button type="button" id="btnPlayAudio" class="btn btn-sm btn-success rounded-circle shadow-sm" style="width:40px; height:40px; padding:0;" title="Oynat / Durdur">
                        <i class="bi bi-play-fill fs-4"></i>
                    </button>

                    <!-- ⏩ 10 sn İleri -->
                    <button type="button" id="btnForward10" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px; height:34px; padding:0;" title="10 Saniye İleri Al">
                        <i class="bi bi-arrow-clockwise fs-6"></i>
                    </button>

                    <div class="ms-1">
                        <span id="audioStatusText" class="small fw-bold text-dark d-block mb-0">Sesli Özet Oynatıcı</span>
                        <span id="audioSubText" class="small text-muted" style="font-size: 0.75rem;">Microsoft Edge Nöral TTS (tr-TR-EmelNeural)</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span id="audioTimeCurrent" class="small fw-bold text-primary" style="font-size: 0.8rem;">00:00</span>
                    <span class="small text-muted">/</span>
                    <span id="audioTimeDuration" class="small text-muted" style="font-size: 0.8rem;">00:00</span>

                    <label class="small text-muted mb-0 ms-2">Hız:</label>
                    <select id="audioSpeedSelect" class="form-select form-select-sm py-0 px-2" style="width: auto; font-size: 0.8rem;">
                        <option value="1.0">1.0x</option>
                        <option value="1.25">1.25x</option>
                        <option value="1.5">1.5x</option>
                        <option value="2.0">2.0x</option>
                    </select>

                    <!-- 🔄 Yeniden Ses Üret -->
                    <button type="button" id="btnRefreshAudioSummary" class="btn btn-sm btn-outline-warning text-dark px-2" title="Yeniden Sesli Özet Üret">
                        <i class="bi bi-arrow-repeat"></i> Yeniden Üret
                    </button>

                    <!-- 🗑️ Sesi Sil -->
                    <button type="button" id="btnDeleteAudioSummary" class="btn btn-sm btn-outline-danger px-2" title="Ses Kaydını Sil">
                        <i class="bi bi-trash"></i> Sesi Sil
                    </button>

                    <a id="btnDownloadAudio" href="#" download class="btn btn-sm btn-outline-secondary d-none" title="MP3 Dosyasını İndir"><i class="bi bi-download"></i> İndir</a>
                </div>
            </div>

            <!-- 🎚️ İlerleme Çubuğu -->
            <div class="px-1">
                <input type="range" id="audioSeekBar" class="form-range" min="0" max="100" value="0" step="0.1" style="cursor: pointer;" />
            </div>

            <audio id="summaryAudioPlayer" class="d-none"></audio>
        </div>
    </div>

    @if (groupedSummaries != null && groupedSummaries.Any())
    {
        <!-- 🎯 DERSLERE GÖRE KÜMELENMİŞ AKORDEON LİSTESİ -->
        <div class="accordion shadow-sm rounded border" id="courseSummariesAccordion">
            @for (int i = 0; i < groupedSummaries.Count; i++)
            {
                var group = groupedSummaries[i];
                string accordionId = $"collapse-course-{group.Key.CourseId}";
                string headingId = $"heading-course-{group.Key.CourseId}";
                bool isFirst = i == 0;

                var courseQuizzes = savedQuizzes != null 
                    ? savedQuizzes.Where(q => q.CourseId == group.Key.CourseId).ToList() 
                    : new List<MiniLms.Models.SavedQuiz>();

                <div class="accordion-item border-0 mb-2 rounded shadow-xs overflow-hidden">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button @(isFirst ? "" : "collapsed") bg-light text-dark fw-bold py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@accordionId">
                            <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                <div>
                                    <span class="badge bg-primary me-2 px-2 py-1">@group.Key.CourseCode</span>
                                    <span class="fs-6 text-dark fw-bold">@group.Key.CourseTitle</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-white text-primary border border-primary px-3 py-1">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> @group.Count() PDF Özeti
                                    </span>
                                    @if (courseQuizzes.Any())
                                    {
                                        <span class="badge bg-warning text-dark border border-warning px-3 py-1">
                                            <i class="bi bi-puzzle-fill me-1"></i> @courseQuizzes.Count Quiz Kayıtlı
                                        </span>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@accordionId" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#courseSummariesAccordion">
                        <div class="accordion-body bg-white p-3">
                            <!-- 1. DERS ÖZETLERİ -->
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-journal-bookmark-fill me-1"></i> Kaydedilmiş Ders Özetleri</h6>
                            <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                                @foreach (var summary in group)
                                {
                                    <div class="col" id="my-summary-card-@summary.Id">
                                        <div class="card h-100 shadow-sm border border-light rounded-3 hover-shadow transition">
                                            <div class="card-header bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="badge bg-secondary me-1" style="font-size: 10px;">ID: #@summary.Id</span>
                                                    @if (!string.IsNullOrEmpty(summary.AudioFilePath))
                                                    {
                                                        <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-volume-up-fill"></i> Sesli Özet Var</span>
                                                    }
                                                </div>
                                                <small class="text-muted" style="font-size: 11px;">⏱️ @summary.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                            </div>
                                            <div class="card-body py-2">
                                                <h6 class="fw-bold text-dark mb-2 text-truncate" title="@summary.CourseDocument?.FileName">
                                                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> @(summary.CourseDocument?.FileName ?? "Ders Dokümanı")
                                                </h6>
                                                <div class="bg-light p-2 rounded border text-muted small" style="max-height: 80px; overflow: hidden; font-size: 0.85rem;">
                                                    @(summary.SummaryText.Length > 160 ? summary.SummaryText.Substring(0, 160) + "..." : summary.SummaryText)
                                                </div>
                                            </div>
                                            <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex flex-wrap align-items-center justify-content-between gap-1">
                                                <div>
                                                    <!-- 🔊 SESLİ DİNLE BUTONU -->
                                                    <button type="button" class="btn btn-xs btn-success btn-sm btn-audio-summary-card" data-courseid="@summary.CourseId" data-docid="@summary.CourseDocumentId" title="Sesli Özeti Dinle">
                                                        <i class="bi bi-volume-up-fill"></i> Sesli Dinle
                                                    </button>
                                                </div>
                                                <div class="d-flex gap-1">
                                                    <button type="button" class="btn btn-xs btn-primary btn-sm btn-view-modal" data-id="@summary.Id" data-title="@summary.CourseDocument?.FileName" title="Özeti Gör"><i class="bi bi-eye"></i> Oku</button>
                                                    <button type="button" class="btn btn-xs btn-warning btn-sm text-white btn-edit-modal" data-id="@summary.Id" title="Özeti Düzenle"><i class="bi bi-pencil-square"></i></button>
                                                    <button type="button" class="btn btn-xs btn-danger btn-sm btn-delete-card" data-id="@summary.Id" title="Özeti Sil"><i class="bi bi-trash"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- 2. DERS QUIZLERI -->
                            @if (courseQuizzes.Any())
                            {
                                <div class="pt-3 border-top">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-puzzle-fill text-warning me-1"></i> Kaydedilmiş Ders Quizleri (#Quiz ID)</h6>
                                    <div class="row row-cols-1 row-cols-md-2 g-3">
                                        @foreach (var quiz in courseQuizzes)
                                        {
                                            <div class="col" id="my-quiz-card-@quiz.Id">
                                                <div class="card h-100 shadow-sm border-warning border-opacity-50 rounded-3">
                                                    <div class="card-header bg-warning bg-opacity-10 border-0 py-2 d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="badge bg-dark me-1" style="font-size: 10px;">Quiz ID: #@quiz.Id</span>
                                                            <span class="badge bg-warning text-dark fw-bold" style="font-size: 10px;">@quiz.Difficulty.ToUpper()</span>
                                                        </div>
                                                        <small class="text-muted" style="font-size: 11px;">⏱️ @quiz.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                                    </div>
                                                    <div class="card-body py-2">
                                                        <h6 class="fw-bold text-dark mb-1 text-truncate" title="@quiz.SourceFileName">
                                                            <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> Kaynak PDF: @(quiz.SourceFileName)
                                                        </h6>
                                                        <small class="text-muted d-block mb-2"><i class="bi bi-question-circle me-1"></i> Toplam @quiz.QuestionCount Soru Hazır</small>
                                                    </div>
                                                    <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                                        <button type="button" class="btn btn-xs btn-primary btn-sm btn-solve-quiz" data-quizid="@quiz.Id" data-courseid="@quiz.CourseId" data-docid="@quiz.CourseDocumentId">
                                                            <i class="bi bi-puzzle-fill me-1"></i> Quizi Çöz (#Quiz-@quiz.Id)
                                                        </button>
                                                        <button type="button" class="btn btn-xs btn-outline-danger btn-sm btn-delete-quiz" data-quizid="@quiz.Id" title="Quizi Sil">
                                                            <i class="bi bi-trash"></i> Sil
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm p-5 text-center my-4">
            <div class="mb-3">
                <i class="bi bi-journal-bookmark text-muted" style="font-size: 3.5rem;"></i>
            </div>
            <h5 class="fw-bold text-secondary">Henüz Kaydedilmiş Ders Özetiniz veya Quiziniz Bulunmuyor</h5>
            <p class="text-muted small">Ders detay sayfasına giderek dokümanlarınız için <strong>"Özetle"</strong> veya <strong>"Quiz"</strong> butonuna tıkladığınızda kayıtlarınız otomatik olarak derslere kümelenerek buraya eklenecektir.</p>
            <div>
                <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-sm px-4"><i class="bi bi-book me-1"></i> Derslere Göz At</a>
            </div>
        </div>
    }
</div>

<!-- 🎯 QUIZ MODALI -->
<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content quiz-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="quizModalLabel">Doküman Quiz</h5>
                    <small class="text-muted" id="quizProgressText">Hazırlanıyor...</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="quizSetup" class="quiz-setup mb-3 d-none">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-4">
                            <label class="form-label small fw-bold text-secondary">Soru Sayısı</label>
                            <select class="form-select form-select-sm" id="quizQuestionCount">
                                <option value="3">3 soru</option>
                                <option value="5" selected>5 soru</option>
                                <option value="10">10 soru</option>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-bold text-secondary">Zorluk</label>
                            <select class="form-select form-select-sm" id="quizDifficulty">
                                <option value="mixed" selected>Karma</option>
                                <option value="easy">Kolay</option>
                                <option value="medium">Orta</option>
                                <option value="hard">Zor</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <button type="button" class="btn btn-primary btn-sm w-100" id="quizStartBtn">Başlat</button>
                        </div>
                    </div>
                </div>

                <div class="progress quiz-progress mb-3" role="progressbar" aria-label="Quiz ilerleme">
                    <div class="progress-bar" id="quizProgressBar" style="width: 0%"></div>
                </div>

                <div id="quizLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-3 mb-0">Quiz hazırlanıyor...</p>
                </div>

                <div id="quizQuestionArea" class="d-none">
                    <div class="quiz-meta mb-3" id="quizMeta"></div>
                    <h5 class="quiz-question" id="quizQuestionText"></h5>
                    <div id="quizOptions" class="quiz-options"></div>
                    <div id="quizFeedback" class="quiz-feedback d-none"></div>
                </div>

                <div id="quizResultArea" class="d-none text-center py-4">
                    <div class="quiz-score" id="quizScoreText"></div>
                    <p class="text-muted mb-3" id="quizScoreDetail"></p>
                    <div id="quizReview" class="text-start"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="quizNextBtn" disabled>Sonraki</button>
            </div>
        </div>
    </div>
</div>

<!-- 🎯 ÖZET OKUMA MODALI -->
<div class="modal fade" id="viewSummaryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title fw-bold text-white" id="viewSummaryModalTitle"><i class="bi bi-book-half"></i> Özet Detayı</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div id="viewSummaryContent" class="p-3 bg-light rounded text-dark" style="line-height: 1.65; font-size: 1.02rem;"></div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- 🎯 ÖZET DÜZENLEME MODALI -->
<div class="modal fade" id="editSummaryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-warning text-white py-2">
                <h6 class="modal-title fw-bold text-white"><i class="bi bi-file-earmark-word"></i> Özeti Düzenle</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="editSummaryId" />
                <div class="mb-2">
                    <label class="form-label small fw-bold text-secondary mb-2"><i class="bi bi-fonts text-primary"></i> Microsoft Word Rehber Düzenleyici</label>
                    <div id="quillEditorMySummariesContainer" style="background: #ffffff; border-radius: 4px;">
                        <div id="quillEditorMySummaries" style="min-height: 280px; font-size: 15px; line-height: 1.6;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-warning text-white btn-sm fw-bold" id="btnSaveEditedSummaryModal"><i class="bi bi-check-circle"></i> Kaydet</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ql-editor h1, .ql-editor h2, .ql-editor h3, #viewSummaryContent h1, #viewSummaryContent h2, #viewSummaryContent h3 {
        color: #0066ff !important;
        font-weight: 700 !important;
    }
    .ql-toolbar.ql-snow {
        border-radius: 6px 6px 0 0;
        background: #f8fafc;
        border-color: #cbd5e1;
    }
    .ql-container.ql-snow {
        border-radius: 0 0 6px 6px;
        border-color: #cbd5e1;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        $(document).ready(function () {
            var viewModal = new bootstrap.Modal(document.getElementById("viewSummaryModal"));
            var editModal = new bootstrap.Modal(document.getElementById("editSummaryModal"));
            var quizModal = new bootstrap.Modal(document.getElementById("quizModal"));

            var quillMySummaries = new Quill('#quillEditorMySummaries', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': ['#000000', '#0066ff', '#0056b3', '#dc3545', '#198754', '#ffc107', '#6c757d', '#6610f2', '#6f42c1', '#d63384', '#fd7e14', '#20c997', '#0dcaf0', '#ffffff'] }, 
                         { 'background': ['#ffffff', '#fff3cd', '#d1e7dd', '#f8d7da', '#cff4fc', '#e2e3e5', '#f8fafc', '#e0e7ff', '#fee2e2', '#dcfce7'] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['clean']
                    ]
                }
            });

            // 🎯 QUIZ STATE
            var quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: null, courseId: null };

            function escapeHtml(text) {
                if (!text) return "";
                return text.toString()
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getDifficultyDotHtml(difficulty) {
                var diff = (difficulty || "").toString().toLowerCase();
                var dotClass = "easy";
                var titleText = "Kolay Seviye (Hatırlama ve Kavrama)";

                if (diff.indexOf("zor") !== -1 || diff.indexOf("hard") !== -1) {
                    dotClass = "hard";
                    titleText = "Zor Seviye (Değerlendirme ve Sentez)";
                } else if (diff.indexOf("orta") !== -1 || diff.indexOf("medium") !== -1) {
                    dotClass = "medium";
                    titleText = "Orta Seviye (Uygulama ve Analiz)";
                } else if (diff.indexOf("kolay") !== -1 || diff.indexOf("easy") !== -1) {
                    dotClass = "easy";
                    titleText = "Kolay Seviye (Hatırlama ve Kavrama)";
                }

                return '<span class="quiz-difficulty-dot ' + dotClass + '" title="' + titleText + '"></span>';
            }

            function resetQuizModal() {
                quizState = { questions: [], currentIndex: 0, answers: [], selectedIndex: null, documentId: quizState.documentId, courseId: quizState.courseId };
                $("#quizModalLabel").text("Doküman Quiz");
                $("#quizProgressText").text("Yükleniyor...");
                $("#quizProgressBar").css("width", "0%");
                $("#quizSetup").addClass("d-none");
                $("#quizLoading").removeClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizFeedback").addClass("d-none").empty();
                $("#quizOptions").empty();
                $("#quizNextBtn").prop("disabled", true).text("Sonraki").removeClass("btn-success").addClass("btn-primary");
            }

            function renderQuizQuestion() {
                var question = quizState.questions[quizState.currentIndex];
                quizState.selectedIndex = quizState.answers[quizState.currentIndex];
                var progress = ((quizState.currentIndex + 1) / quizState.questions.length) * 100;

                $("#quizLoading").addClass("d-none");
                $("#quizResultArea").addClass("d-none");
                $("#quizQuestionArea").removeClass("d-none");
                $("#quizProgressBar").css("width", progress + "%");

                var dotHtml = getDifficultyDotHtml(question.difficulty);

                $("#quizMeta").html(
                    "<div class='d-flex justify-content-between align-items-center w-100'>" +
                    "<div class='d-flex align-items-center gap-1 flex-wrap'>" +
                    "<span class='quiz-pill'>" + escapeHtml(question.difficulty || "Orta") + "</span>" +
                    "<span class='quiz-pill'>" + escapeHtml(question.bloomLevel || "Anlama") + "</span>" +
                    "<span class='quiz-pill muted'>" + escapeHtml(question.topic || "Doküman içeriği") + "</span>" +
                    "</div>" +
                    "<div class='d-flex align-items-center gap-2 me-1' title='Sorunun Zorluk Seviyesi (Bloom Taksonomisi)'>" +
                    "<small class='text-muted fw-bold' style='font-size: 0.72rem;'>ZORLUK:</small>" +
                    dotHtml +
                    "</div>" +
                    "</div>"
                );
                $("#quizQuestionText").text(question.question);
                $("#quizFeedback").addClass("d-none").empty();
                $("#quizNextBtn")
                    .prop("disabled", quizState.selectedIndex === null)
                    .text(quizState.currentIndex === quizState.questions.length - 1 ? "Bitir" : "Sonraki")
                    .removeClass("btn-success")
                    .addClass("btn-primary");

                var optionsHtml = "";
                question.options.forEach(function (option, index) {
                    var selectedClass = quizState.selectedIndex === index ? " selected" : "";
                    optionsHtml += "<button type='button' class='quiz-option" + selectedClass + "' data-index='" + index + "'><span>" + String.fromCharCode(65 + index) + "</span><strong>" + escapeHtml(option) + "</strong></button>";
                });
                $("#quizOptions").html(optionsHtml);
            }

            $(document).on("click", ".quiz-option", function () {
                quizState.selectedIndex = parseInt($(this).data("index"));
                $(".quiz-option").removeClass("selected");
                $(this).addClass("selected");
                $("#quizNextBtn").prop("disabled", false);
            });

            $("#quizNextBtn").click(function () {
                if (quizState.selectedIndex === null) return;
                quizState.answers[quizState.currentIndex] = quizState.selectedIndex;

                if (quizState.currentIndex >= quizState.questions.length - 1) {
                    renderQuizResult();
                    return;
                }
                quizState.currentIndex++;
                renderQuizQuestion();
            });

            function renderQuizResult() {
                var score = 0;
                var reviewHtml = "";

                quizState.questions.forEach(function (question, index) {
                    var userAnswer = quizState.answers[index];
                    var isCorrect = userAnswer === question.correctIndex;
                    if (isCorrect) score++;

                    reviewHtml += "<div class='quiz-review-item " + (isCorrect ? "correct" : "incorrect") + " position-relative shadow-sm'>";
                    reviewHtml += "<div class='position-absolute top-0 end-0 m-3 d-flex align-items-center gap-1'>" + getDifficultyDotHtml(question.difficulty) + "</div>";
                    reviewHtml += "<h6 class='fw-bold mb-2'>" + (index + 1) + ". " + escapeHtml(question.question) + "</h6>";
                    reviewHtml += "<div class='quiz-review-meta mb-2'><span>" + escapeHtml(question.difficulty || "Orta") + "</span><span>" + escapeHtml(question.bloomLevel || "Anlama") + "</span><span>" + escapeHtml(question.topic || "Doküman içeriği") + "</span></div>";

                    reviewHtml += "<div class='my-2'>";
                    question.options.forEach(function (optText, optIdx) {
                        var letter = String.fromCharCode(65 + optIdx);
                        if (optIdx === question.correctIndex) {
                            reviewHtml += "<div class='quiz-review-option correct-option'><span class='d-flex align-items-center gap-2'><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span> <span class='badge bg-success text-white px-2 py-1' style='font-size: 0.75rem;'><i class='bi bi-check-circle-fill me-1'></i> Doğru Cevap</span></div>";
                        } else if (optIdx === userAnswer && !isCorrect) {
                            reviewHtml += "<div class='quiz-review-option wrong-option'><span class='d-flex align-items-center gap-2'><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span> <span class='badge bg-danger text-white px-2 py-1' style='font-size: 0.75rem;'><i class='bi bi-x-circle-fill me-1'></i> Senin Yanlış Seçimin</span></div>";
                        } else {
                            reviewHtml += "<div class='quiz-review-option neutral-option'><span><strong>" + letter + ")</strong> " + escapeHtml(optText) + "</span></div>";
                        }
                    });
                    reviewHtml += "</div>";

                    reviewHtml += "<div class='mt-2 p-2 rounded bg-white bg-opacity-60 border'>" +
                                  "<small class='d-block text-dark fw-bold'><i class='bi bi-info-circle me-1 text-primary'></i> AÇIKLAMA:</small>" +
                                  "<small class='text-secondary'>" + escapeHtml(question.explanation || "") + "</small>";

                    if (question.whyWrong && question.whyWrong[userAnswer] && userAnswer !== question.correctIndex) {
                        reviewHtml += "<small class='d-block mt-1 text-danger fw-bold'><i class='bi bi-exclamation-triangle me-1'></i> Seçimin Neden Yanlış: " + escapeHtml(question.whyWrong[userAnswer]) + "</small>";
                    }
                    if (question.sourceHint) {
                        reviewHtml += "<small class='d-block mt-1 text-muted'><i class='bi bi-search me-1'></i> Kaynak İpucu: " + escapeHtml(question.sourceHint) + "</small>";
                    }
                    reviewHtml += "</div></div>";
                });

                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizProgressText").text("Tamamlandı");
                $("#quizProgressBar").css("width", "100%");
                $("#quizScoreText").text(score + " / " + quizState.questions.length);
                $("#quizScoreDetail").text("Quiz tamamlandı. Aşağıda cevaplarını kontrol edebilirsin.");
                $("#quizReview").html(reviewHtml);
                $("#quizNextBtn").prop("disabled", true).text("Tamamlandı").removeClass("btn-primary").addClass("btn-success");
            }

            function showQuizError(message) {
                $("#quizLoading").addClass("d-none");
                $("#quizQuestionArea").addClass("d-none");
                $("#quizResultArea").removeClass("d-none");
                $("#quizScoreText").text("Quiz yüklenemedi");
                $("#quizScoreDetail").text(message);
                $("#quizReview").empty();
                $("#quizNextBtn").prop("disabled", true);
            }

            // 🎯 KAYDEDİLMİŞ QUIZI ÇÖZ
            $(document).on("click", ".btn-solve-quiz", function () {
                var quizId = $(this).data("quizid");
                var courseId = $(this).data("courseid");
                var docId = $(this).data("docid");

                quizState.documentId = docId;
                quizState.courseId = courseId;

                resetQuizModal();
                quizModal.show();

                $.ajax({
                    url: '@Url.Action("DocumentQuizSession", "Course")',
                    type: 'GET',
                    data: { courseId: courseId, documentId: docId, quizId: quizId },
                    success: function (data) {
                        if (data.success && data.questions && data.questions.length > 0) {
                            var cacheBadge = " <span class='badge bg-info text-white' style='font-size:0.75rem!important;'>💾 Kaydedilmiş Quiz (ID: #" + data.quizId + ")</span>";
                            $("#quizModalLabel").html(escapeHtml(data.title || "Doküman Quiz") + cacheBadge);
                            if (data.sourceFileName) {
                                $("#quizProgressText").html("<span class='text-primary fw-bold'><i class='bi bi-file-earmark-pdf-fill text-danger me-1'></i> Kaynak PDF: " + escapeHtml(data.sourceFileName) + "</span>");
                            }

                            quizState.questions = data.questions;
                            quizState.answers = new Array(data.questions.length).fill(null);
                            quizState.currentIndex = 0;
                            renderQuizQuestion();
                        } else {
                            showQuizError(data.response || "Quiz yüklenemedi.");
                        }
                    },
                    error: function () {
                        showQuizError("Quiz verisi alınırken sunucu hatası oluştu.");
                    }
                });
            });

            // 🎯 KAYDEDİLMİŞ QUIZI SİL
            $(document).on("click", ".btn-delete-quiz", function () {
                var quizId = $(this).data("quizid");
                var docId = $(this).data("docid");
                if (confirm("Quiz #" + quizId + " numaralı quizi kalıcı olarak silmek istediğinize emin misiniz?")) {
                    $.ajax({
                        url: '@Url.Action("DeleteQuiz", "Course")',
                        type: 'POST',
                        data: { quizId: quizId, documentId: docId },
                        success: function (res) {
                            if (res.success) {
                                $("#my-quiz-card-" + quizId).fadeOut(300, function () { $(this).remove(); });
                                alert("✅ " + res.message);
                                location.reload();
                            } else {
                                alert("⚠️ " + (res.message || "Quiz silinemedi."));
                            }
                        },
                        error: function (xhr, status, error) {
                            alert("⚠️ Quiz silinirken sunucu hatası oluştu: " + error);
                        }
                    });
                }
            });

            // 🎯 SESLİ ÖZET JS KODLARI
            var audioState = { isPlaying: false };
            var activeAudioState = { courseId: null, documentId: null };
            var activeAudioRequestId = 0;

            function stopCurrentAudioPlayback() {
                var player = document.getElementById("summaryAudioPlayer");
                if (player) {
                    try {
                        player.pause();
                        player.currentTime = 0;
                        player.removeAttribute("src");
                        player.load();
                    } catch (e) { }
                }
                if ('speechSynthesis' in window) {
                    try { window.speechSynthesis.cancel(); } catch (e) { }
                }
                audioState.isPlaying = false;
                $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>').prop("disabled", false);
                $("#audioTimeCurrent").text("00:00");
                $("#audioTimeDuration").text("00:00");
                $("#audioSeekBar").val(0);
            }

            function triggerAudioSummary(courseId, docId, forceRefresh) {
                if (!docId || !courseId) return;

                stopCurrentAudioPlayback();
                var thisRequestId = ++activeAudioRequestId;

                activeAudioState.courseId = courseId;
                activeAudioState.documentId = docId;

                var playerContainer = $("#audioPlayerContainer");
                playerContainer.removeClass("d-none");
                $('html, body').animate({ scrollTop: playerContainer.offset().top - 100 }, 300);

                $("#audioStatusText").text(forceRefresh ? "Yeni Sesli Özet Üretiliyor..." : "Sesli Özet Yükleniyor...");
                $("#audioSubText").text(forceRefresh ? "Edge Nöral Seslendirmesi Yapılıyor..." : "Önbellekten veya Ses Servisinden Çekiliyor");
                $("#btnPlayAudio").html('<div class="spinner-border spinner-border-sm text-light" role="status"></div>').prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("GetAudioSummary", "Course")',
                    type: 'GET',
                    data: { courseId: courseId, documentId: docId, forceRefresh: forceRefresh === true },
                    success: function (res) {
                        if (thisRequestId !== activeAudioRequestId) return;
                        $("#btnPlayAudio").prop("disabled", false);

                        if (res.success && res.audioUrl) {
                            var player = document.getElementById("summaryAudioPlayer");
                            player.src = res.audioUrl;
                            $("#btnDownloadAudio").attr("href", res.audioUrl).removeClass("d-none");
                            $("#audioStatusText").text("Sesli Özet Hazır");
                            $("#audioSubText").text(res.isCached ? "💾 Önbellekten Yüklendi (Kayıtlı Ses)" : "✨ Microsoft Edge Nöral TTS (Yeni Ses)");
                            $("#btnPlayAudio").html('<i class="bi bi-pause-fill fs-4"></i>');
                            
                            var playPromise = player.play();
                            if (playPromise !== undefined) {
                                playPromise.then(function () {
                                    audioState.isPlaying = true;
                                }).catch(function (err) {
                                    $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>');
                                });
                            }

                            player.onended = function () {
                                audioState.isPlaying = false;
                                $("#btnPlayAudio").html('<i class="bi bi-play-fill fs-4"></i>');
                            };
                        } else {
                            stopCurrentAudioPlayback();
                            playerContainer.addClass("d-none");
                            alert("⚠️ " + (res.message || "Ses kaydı alınamadı."));
                        }
                    },
                    error: function () {
                        if (thisRequestId !== activeAudioRequestId) return;
                        stopCurrentAudioPlayback();
                        playerContainer.addClass("d-none");
                        alert("Sesli özet servisine bağlanırken sunucu hatası oluştu.");
                    }
                });
            }

            $(document).on("click", ".btn-audio-summary-card", function () {
                var courseId = $(this).data("courseid");
                var docId = $(this).data("docid");
                triggerAudioSummary(courseId, docId, false);
            });

            $("#btnRefreshAudioSummary").click(function () {
                if (activeAudioState.courseId && activeAudioState.documentId) {
                    if (confirm("Bu dokümanın sesli özetini yeniden ürettirmek istediğinizden emin misiniz?")) {
                        triggerAudioSummary(activeAudioState.courseId, activeAudioState.documentId, true);
                    }
                }
            });

            $("#btnDeleteAudioSummary").click(function () {
                if (activeAudioState.courseId && activeAudioState.documentId) {
                    if (confirm("Bu dokümana ait ses kaydını silmek istediğinize emin misiniz?")) {
                        stopCurrentAudioPlayback();
                        $("#audioPlayerContainer").addClass("d-none");

                        $.post('@Url.Action("DeleteAudioSummary", "Course")', { 
                            courseId: activeAudioState.courseId, 
                            documentId: activeAudioState.documentId 
                        }, function (res) {
                            if (res.success) {
                                alert("✅ " + res.message);
                                location.reload();
                            } else {
                                alert("⚠️ " + res.message);
                            }
                        });
                    }
                }
            });

            function formatAudioTime(seconds) {
                if (isNaN(seconds) || seconds < 0) return "00:00";
                var mins = Math.floor(seconds / 60);
                var secs = Math.floor(seconds % 60);
                return (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs);
            }

            var playerElement = document.getElementById("summaryAudioPlayer");
            if (playerElement) {
                playerElement.ontimeupdate = function () {
                    if (playerElement.duration) {
                        var percent = (playerElement.currentTime / playerElement.duration) * 100;
                        $("#audioSeekBar").val(percent);
                        $("#audioTimeCurrent").text(formatAudioTime(playerElement.currentTime));
                    }
                };

                playerElement.onloadedmetadata = function () {
                    $("#audioTimeDuration").text(formatAudioTime(playerElement.duration));
                };
            }

            $("#audioSeekBar").on("input change", function () {
                if (playerElement && playerElement.duration) {
                    var seekTo = ($(this).val() / 100) * playerElement.duration;
                    playerElement.currentTime = seekTo;
                }
            });

            $("#btnRewind10").click(function () {
                if (playerElement && playerElement.src) {
                    playerElement.currentTime = Math.max(0, playerElement.currentTime - 10);
                }
            });

            $("#btnForward10").click(function () {
                if (playerElement && playerElement.src) {
                    playerElement.currentTime = Math.min(playerElement.duration || 0, playerElement.currentTime + 10);
                }
            });

            $("#btnPlayAudio").click(function () {
                if (playerElement && playerElement.src) {
                    if (playerElement.paused) {
                        playerElement.play();
                        $(this).html('<i class="bi bi-pause-fill fs-4"></i>');
                    } else {
                        playerElement.pause();
                        $(this).html('<i class="bi bi-play-fill fs-4"></i>');
                    }
                }
            });

            $("#audioSpeedSelect").change(function () {
                var speed = parseFloat($(this).val());
                if (playerElement) {
                    playerElement.playbackRate = speed;
                }
            });

            // METİN ÖZETİ İŞLEMLERİ
            function formatAiResponseToHtml(rawText) {
                if (!rawText) return "";
                if (rawText.indexOf("<p>") !== -1 || rawText.indexOf("<strong>") !== -1 || rawText.indexOf("<h") !== -1) {
                    return rawText;
                }
                var text = rawText;
                text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                text = text.replace(/\n\n+/g, '</p><p>');
                return '<p>' + text + '</p>';
            }

            $(".btn-view-modal").click(function () {
                var summaryId = $(this).data("id");
                var title = $(this).data("title");
                $("#viewSummaryModalTitle").text("Özet Detayı - " + title);
                $("#viewSummaryContent").html("<span class='text-muted'>Yükleniyor...</span>");
                viewModal.show();

                $.get('@Url.Action("GetSummaryById", "Course")', { summaryId: summaryId }, function (res) {
                    if (res.success) {
                        $("#viewSummaryContent").html(formatAiResponseToHtml(res.summaryText));
                    } else {
                        $("#viewSummaryContent").html("<span class='text-danger'>" + res.message + "</span>");
                    }
                });
            });

            $(".btn-edit-modal").click(function () {
                var summaryId = $(this).data("id");
                $.get('@Url.Action("GetSummaryById", "Course")', { summaryId: summaryId }, function (res) {
                    if (res.success) {
                        $("#editSummaryId").val(res.summaryId);
                        quillMySummaries.root.innerHTML = formatAiResponseToHtml(res.summaryText);
                        editModal.show();
                    } else {
                        alert(res.message);
                    }
                });
            });

            $("#btnSaveEditedSummaryModal").click(function () {
                var summaryId = $("#editSummaryId").val();
                var text = quillMySummaries.root.innerHTML;

                $.post('@Url.Action("UpdateSummary", "Course")', { summaryId: summaryId, summaryText: text }, function (res) {
                    if (res.success) {
                        editModal.hide();
                        alert("Özet başarıyla güncellendi.");
                        location.reload();
                    } else {
                        alert("Hata: " + res.message);
                    }
                });
            });

            $(".btn-delete-card").click(function () {
                var summaryId = $(this).data("id");
                if (confirm("ID #" + summaryId + " numaralı özeti kalıcı olarak silmek istediğinize emin misiniz?")) {
                    $.post('@Url.Action("DeleteSummary", "Course")', { summaryId: summaryId }, function (res) {
                        if (res.success) {
                            $("#my-summary-card-" + summaryId).fadeOut(300, function () { $(this).remove(); });
                            alert("Özet silindi.");
                            location.reload();
                        } else {
                            alert("Hata: " + res.message);
                        }
                    });
                }
            });
        });
    </script>
}
