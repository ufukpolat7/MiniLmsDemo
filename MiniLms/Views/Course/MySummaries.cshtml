                if (confirm("Özet #" + summaryId + " numaralı özeti kalıcı olarak silmek istediğinize emin misiniz?")) {
                    $.ajax({
                        url: '@Url.Action("DeleteSummary", "Course")',
                        type: 'POST',
                        data: { summaryId: summaryId },
                        success: function (res) {
                            if (res.success) {
                                $("#my-summary-card-" + summaryId).fadeOut(300, function () { $(this).remove(); });
                                alert("✅ Özet silindi.");
                            } else {
                                alert("⚠️ " + res.message);
                            }
                        },
                        error: function () {
                            alert("Özet silinirken hata oluştu.");
                        }
                    });
                }
            });
        });
    </script>
}
