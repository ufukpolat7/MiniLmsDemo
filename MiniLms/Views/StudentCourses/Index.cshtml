@model MiniLms.ViewModels.StudentCourseListViewModel

@{
    ViewData["Title"] = "Derslerim";
}

<section class="page-hero">
    <div class="d-flex align-items-center gap-3">
        <span class="hero-icon"><i class="bi bi-journal-check"></i></span>
        <div>
            <h1 class="page-title">Derslerim</h1>
            <p class="page-subtitle">Açılan dersleri görüntüleyin, kayıt olun ve kendi kayıtlarınızı yönetin.</p>
        </div>
    </div>
</section>

<div class="mb-4">
    <h2 class="section-title">Kayıtlı Olduğum Dersler</h2>
    <div class="card table-card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Kredi</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Enrollments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı olduğunuz bir ders yok.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var enrollment in Model.Enrollments)
                        {
                            <tr>
                                <td class="fw-bold text-danger">@enrollment.Course?.CourseCode</td>
                                <td>@enrollment.Course?.Title</td>
                                <td><span class="badge bg-secondary">@enrollment.Course?.Credits AKTS</span></td>
                                <td>@enrollment.EnrollmentDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="Course" asp-action="Details" asp-route-id="@enrollment.CourseId" class="btn btn-info text-white">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                        <form asp-action="Unenroll" method="post" class="d-inline" onsubmit="return confirm('\'@enrollment.Course?.Title\' (@enrollment.Course?.CourseCode) dersine olan kaydınızı silmek istediğinizden emin misiniz?');">
                                            <input type="hidden" name="courseId" value="@enrollment.CourseId" />
                                            <button type="submit" class="btn btn-danger">
                                                <i class="bi bi-x-circle"></i> Kaydı Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div>
    <h2 class="section-title">Tüm Dersler</h2>
    <div class="card table-card">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Ders Kodu</th>
                        <th>Ders Adı</th>
                        <th>Açıklama</th>
                        <th>Kredi</th>
                        <th class="text-center">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Courses.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Sistemde henüz açılmış bir ders bulunmamaktadır.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var course in Model.Courses)
                        {
                            var isEnrolled = Model.EnrolledCourseIds.Contains(course.Id);

                            <tr>
                                <td class="fw-bold text-danger">@course.CourseCode</td>
                                <td>@course.Title</td>
                                <td>@course.Description</td>
                                <td><span class="badge bg-secondary">@course.Credits AKTS</span></td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-info text-white">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                        @if (isEnrolled)
                                        {
                                            <button type="button" class="btn btn-secondary" disabled>
                                                <i class="bi bi-check-circle"></i> Kayıtlı
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="Enroll" method="post" class="d-inline">
                                                <input type="hidden" name="courseId" value="@course.Id" />
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bi bi-plus-circle"></i> Kayıt Ol
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
