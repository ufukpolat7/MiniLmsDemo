<!DOCTYPE html>
@using Microsoft.AspNetCore.Identity
@using MiniLms.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniLms</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniLms.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                    MiniLms
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Ana Sayfa
                            </a>
                        </li>
                        @if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Student" asp-action="Index">
                                    <i class="bi bi-people"></i> Öğrenciler
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Course" asp-action="Index">
                                <i class="bi bi-book"></i> Dersler
                            </a>
                        </li>
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="StudentCourses" asp-action="Index">
                                    <i class="bi bi-journal-check"></i> Derslerim
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Course" asp-action="MySummaries">
                                    <i class="bi bi-bookmark-star-fill text-warning"></i> Özel Özetlerim
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Course" asp-action="MyKnowledgeGaps">
                                    <i class="bi bi-exclamation-triangle-fill text-danger"></i> Eksiklerim & Yanlışlarım
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Enrollment" asp-action="Index">
                                    <i class="bi bi-pen"></i> Ders Kayıtları
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Course" asp-action="MySummaries">
                                    <i class="bi bi-patch-check-fill text-success"></i> Yayınlanan Ders Özetleri
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock"></i> Gizlilik
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var roles = currentUser == null
                                ? new List<string>()
                                : await UserManager.GetRolesAsync(currentUser);

                            <li class="nav-item d-flex align-items-center">
                                <span class="navbar-text text-dark small">
                                    <i class="bi bi-person-circle"></i>
                                    @(currentUser?.FirstName ?? User.Identity?.Name)
                                    @if (roles.Any())
                                    {
                                        <span class="badge bg-primary ms-1">@string.Join(", ", roles)</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Çıkış Yap">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Giriş
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Kayıt
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer py-3">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small">
            <span>&copy; @DateTime.Now.Year MiniLms</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
        // Herhangi bir sayfada TempData["SuccessMessage"] tetiklenirse sağ üstte Toast gösterir
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                timer: 3000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
                });
            </text>
        }

        // Herhangi bir sayfada TempData["ErrorMessage"] tetiklenirse ekrana büyük Hata Modal'ı basar
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                Swal.fire({
                icon: 'error',
                title: 'Hata!',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonText: 'Tamam',
                confirmButtonColor: '#dc3545'
                });
            </text>
        }
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
